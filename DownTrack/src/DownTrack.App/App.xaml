<Application
    x:Class="DownTrack.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowTextBrush" Color="#F7F5FF" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A8A4B8" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#34FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowTextBrush" Color="#141218" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#625E6C" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#635BFF" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#28FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
