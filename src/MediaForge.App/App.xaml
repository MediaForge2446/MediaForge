<Application x:Class="MediaForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MediaForge.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanNotConverter x:Key="BooleanNotConverter"/>
            <conv:BooleanToVisibilityConverterFallback x:Key="BooleanToVisibilityConverterFallback"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <conv:DirectoryGlyphConverter x:Key="DirectoryGlyphConverter"/>
            <conv:PendingBrushConverter x:Key="PendingBrushConverter"/>
            <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>

            <SolidColorBrush x:Key="MediaForgeBackgroundBrush" Color="#F5F8FC"/>
            <SolidColorBrush x:Key="MediaForgeSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MediaForgeSurfaceElevatedBrush" Color="#FBFCFE"/>
            <SolidColorBrush x:Key="MediaForgeBorderBrush" Color="#DDE5EF"/>
            <SolidColorBrush x:Key="MediaForgeTextBrush" Color="#182334"/>
            <SolidColorBrush x:Key="MediaForgeMutedBrush" Color="#738197"/>
            <SolidColorBrush x:Key="MediaForgeAccentBrush" Color="#2F80ED"/>
            <SolidColorBrush x:Key="MediaForgeAccentSoftBrush" Color="#EAF3FF"/>
            <SolidColorBrush x:Key="MediaForgePendingBrush" Color="#E6A700"/>
            <SolidColorBrush x:Key="MediaForgeSuccessBrush" Color="#2EAF69"/>
            <SolidColorBrush x:Key="MediaForgeErrorBrush" Color="#D94C59"/>
            <SolidColorBrush x:Key="MediaForgeDangerSoftBrush" Color="#FFF1F2"/>
            <SolidColorBrush x:Key="MediaForgePendingSoftBrush" Color="#FFF8E7"/>

            <Style x:Key="MediaForgeNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#6D7A8D"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder" CornerRadius="14" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#EFF5FD"/>
                                    <Setter Property="Foreground" Value="#234A7A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#E4EFFC"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Active">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#E8F2FF"/>
                                    <Setter Property="Foreground" Value="#1769C2"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaForgePrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Background" Value="#2F80ED"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4B92EE"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#236FD1"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaForgeSubtleButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#344256"/>
                <Setter Property="BorderBrush" Value="#D7E0EA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#F5F8FC"/><Setter TargetName="B" Property="BorderBrush" Value="#C5D2E1"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#EDF2F7"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaForgeDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaForgeSubtleButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource MediaForgeErrorBrush}"/>
                <Setter Property="Background" Value="{StaticResource MediaForgeDangerSoftBrush}"/>
                <Setter Property="BorderBrush" Value="#F2CED2"/>
            </Style>

            <Style x:Key="MediaForgeInputStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Padding" Value="13,0"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/>
                <Setter Property="BorderBrush" Value="#D7E0EA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MediaForgeInlineInputStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}">
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="MediaForgePathBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="MediaForgeComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/>
                <Setter Property="BorderBrush" Value="#D7E0EA"/>
                <Setter Property="FontSize" Value="11.5"/>
            </Style>

            <Style x:Key="MediaForgeCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MediaForgeSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>