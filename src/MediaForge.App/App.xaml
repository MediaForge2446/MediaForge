<Application x:Class="MediaForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MediaForge.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <conv:BooleanToVisibilityConverterFallback x:Key="BooleanToVisibilityConverterFallback"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <conv:DirectoryGlyphConverter x:Key="DirectoryGlyphConverter"/>

            <SolidColorBrush x:Key="MediaForgeBackgroundBrush" Color="#F4F7FB"/>
            <SolidColorBrush x:Key="MediaForgeSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MediaForgeSurfaceSoftBrush" Color="#F8FAFD"/>
            <SolidColorBrush x:Key="MediaForgeBorderBrush" Color="#E1E7EF"/>
            <SolidColorBrush x:Key="MediaForgeTextBrush" Color="#1F2937"/>
            <SolidColorBrush x:Key="MediaForgeMutedBrush" Color="#6B778C"/>
            <SolidColorBrush x:Key="MediaForgeAccentBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="MediaForgeAccentSoftBrush" Color="#EDF4FF"/>
            <SolidColorBrush x:Key="MediaForgePendingBrush" Color="#C88A00"/>
            <SolidColorBrush x:Key="MediaForgePendingSoftBrush" Color="#FFF7E5"/>
            <SolidColorBrush x:Key="MediaForgeSuccessBrush" Color="#2E9E68"/>
            <SolidColorBrush x:Key="MediaForgeErrorBrush" Color="#CF4558"/>
            <SolidColorBrush x:Key="MediaForgeDangerSoftBrush" Color="#FFF1F3"/>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/>
            </Style>

            <Style x:Key="MediaForgePrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Background" Value="{StaticResource MediaForgeAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaForgeSubtleButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#344154"/>
                <Setter Property="BorderBrush" Value="#D8E0EA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F8FC"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C7D4E2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF2F8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaForgeDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaForgeSubtleButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource MediaForgeErrorBrush}"/>
                <Setter Property="Background" Value="{StaticResource MediaForgeDangerSoftBrush}"/>
                <Setter Property="BorderBrush" Value="#F0CAD0"/>
            </Style>

            <Style x:Key="MediaForgeInputStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Padding" Value="13,0"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/>
                <Setter Property="BorderBrush" Value="#D5DEE9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <Style x:Key="MediaForgePathBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="11.5"/>
            </Style>

            <Style x:Key="MediaForgeComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/>
                <Setter Property="BorderBrush" Value="#D5DEE9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11.5"/>
            </Style>

            <Style x:Key="MediaForgeCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MediaForgeSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
