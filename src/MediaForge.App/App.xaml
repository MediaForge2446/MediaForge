<Application x:Class="MediaForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MediaForge.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ui:ThemesDictionary Theme="Dark"/><ui:ControlsDictionary/></ResourceDictionary.MergedDictionaries>
            <conv:BooleanNotConverter x:Key="BooleanNotConverter"/><conv:BooleanToVisibilityConverterFallback x:Key="BooleanToVisibilityConverterFallback"/><conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/><conv:DirectoryGlyphConverter x:Key="DirectoryGlyphConverter"/><conv:PendingBrushConverter x:Key="PendingBrushConverter"/>
            <SolidColorBrush x:Key="MediaForgeBackgroundBrush" Color="#090C10"/><SolidColorBrush x:Key="MediaForgeSurfaceBrush" Color="#11161C"/><SolidColorBrush x:Key="MediaForgeSurfaceElevatedBrush" Color="#171D24"/><SolidColorBrush x:Key="MediaForgeBorderBrush" Color="#28313B"/><SolidColorBrush x:Key="MediaForgeTextBrush" Color="#F5F7FA"/><SolidColorBrush x:Key="MediaForgeMutedBrush" Color="#8994A2"/><SolidColorBrush x:Key="MediaForgeAccentBrush" Color="#60CDFF"/><SolidColorBrush x:Key="MediaForgePendingBrush" Color="#FFC857"/><SolidColorBrush x:Key="MediaForgeSuccessBrush" Color="#57D391"/><SolidColorBrush x:Key="MediaForgeErrorBrush" Color="#FF7373"/>

            <Style x:Key="MediaForgeNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8E99A6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#17222B"/><Setter Property="Foreground" Value="#E9F4FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#1C303D"/></Trigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Active"><Setter TargetName="NavBorder" Property="Background" Value="#153646"/><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="MediaForgePrimaryButtonStyle" TargetType="Button"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="18,0"/><Setter Property="Background" Value="#60CDFF"/><Setter Property="Foreground" Value="#061117"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="11" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#86DEFF"/><Setter TargetName="B" Property="RenderTransform" Value="{x:Null}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#43BEEA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="MediaForgeSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaForgePrimaryButtonStyle}"><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="#171D24"/><Setter Property="Foreground" Value="#E7ECF0"/><Setter Property="BorderBrush" Value="#2B3540"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#202A33"/><Setter TargetName="B" Property="BorderBrush" Value="#3A4652"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#26323D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="MediaForgeDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaForgeSubtleButtonStyle}"><Setter Property="Foreground" Value="{StaticResource MediaForgeErrorBrush}"/></Style>
            <Style x:Key="MediaForgeInputStyle" TargetType="TextBox"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="13,0"/><Setter Property="Background" Value="#11161C"/><Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/><Setter Property="BorderBrush" Value="#2B3540"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            <Style x:Key="MediaForgeInlineInputStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="6,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
            <Style x:Key="MediaForgePathBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/></Style>
            <Style x:Key="MediaForgeComboStyle" TargetType="ComboBox"><Setter Property="Height" Value="42"/><Setter Property="Background" Value="#171D24"/><Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}"/><Setter Property="BorderBrush" Value="#2B3540"/></Style>
            <Style x:Key="MediaForgeCardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource MediaForgeSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
