<Application x:Class="MediaForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MediaForge.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanNotConverter x:Key="BooleanNotConverter" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <conv:DirectoryGlyphConverter x:Key="DirectoryGlyphConverter" />
            <conv:PendingBrushConverter x:Key="PendingBrushConverter" />

            <SolidColorBrush x:Key="MediaForgeBackgroundBrush" Color="#0F1115" />
            <SolidColorBrush x:Key="MediaForgeSurfaceBrush" Color="#171A20" />
            <SolidColorBrush x:Key="MediaForgeSurfaceElevatedBrush" Color="#1E222A" />
            <SolidColorBrush x:Key="MediaForgeBorderBrush" Color="#2D333D" />
            <SolidColorBrush x:Key="MediaForgeTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="MediaForgeMutedBrush" Color="#9EA5B1" />
            <SolidColorBrush x:Key="MediaForgeAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="MediaForgePendingBrush" Color="#FFC107" />
            <SolidColorBrush x:Key="MediaForgeSuccessBrush" Color="#49C97D" />
            <SolidColorBrush x:Key="MediaForgeErrorBrush" Color="#FF6B6B" />

            <Style x:Key="MediaForgeNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="8,3" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MediaForgeMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="MediaForgePrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Background" Value="{StaticResource MediaForgeAccentBrush}" />
                <Setter Property="Foreground" Value="#061018" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="MediaForgeSubtleButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="{StaticResource MediaForgeSurfaceElevatedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="MediaForgeDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaForgeSubtleButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource MediaForgeErrorBrush}" />
            </Style>

            <Style x:Key="MediaForgeInputStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="#12151A" />
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="MediaForgeInlineInputStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MediaForgePathBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MediaForgeInputStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="MediaForgeComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="42" />
                <Setter Property="Background" Value="{StaticResource MediaForgeSurfaceElevatedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MediaForgeTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}" />
            </Style>

            <Style x:Key="MediaForgeCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MediaForgeSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MediaForgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
