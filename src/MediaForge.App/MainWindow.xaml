<ui:FluentWindow x:Class="MediaForge.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
                 xmlns:views="clr-namespace:MediaForge.App.Views"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="MediaForge"
                 Width="1440"
                 Height="900"
                 MinWidth="1120"
                 MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource MediaForgeBackgroundBrush}"
                 Foreground="{StaticResource MediaForgeTextBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="MediaForge" Margin="0,0,0,4"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True">
            <ui:TitleBar.Icon>
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource MediaForgeAccentBrush}">
                    <TextBlock Text="M" Foreground="#061018" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#14171C" CornerRadius="14,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="90" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="96" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,20,16,10">
                            <TextBlock Text="MEDIAFORGE" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Media manager • Windows 11" Margin="0,4,0,0" FontSize="10"
                                       Foreground="{StaticResource MediaForgeMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="WORKSPACE" Margin="20,0,0,7" FontSize="10" FontWeight="Bold" Foreground="#68717D" />
                            <Button Style="{StaticResource MediaForgeNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="home">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" Width="30" FontSize="18" />
                                    <TextBlock Text="הספרייה שלי" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MediaForgeNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="explorer">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" Width="30" FontSize="17" />
                                    <TextBlock Text="סייר הקבצים" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MediaForgeNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="downloads">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↓" Width="30" FontSize="19" />
                                    <TextBlock Text="הורדת מדיה" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Separator Margin="20,16" Background="#2A3038" />
                            <TextBlock Text="SYSTEM" Margin="20,0,0,7" FontSize="10" FontWeight="Bold" Foreground="#68717D" />
                            <Button Style="{StaticResource MediaForgeNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Width="30" FontSize="17" />
                                    <TextBlock Text="הגדרות וכלים" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Margin="14,10" Padding="13" Background="#0F1216" CornerRadius="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MediaForgeSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" מערכת מוכנה" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="כלים מנוהלים ברקע" Margin="0,7,0,0" FontSize="10" Foreground="{StaticResource MediaForgeMutedBrush}" />
                                <TextBlock Text="yt-dlp • FFmpeg" Margin="0,3,0,0" FontSize="10" Foreground="#737C88" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource MediaForgeBorderBrush}" />

                <Grid Grid.Column="2" Margin="34,28,34,24" FlowDirection="LeftToRight">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" FontSize="11"
                                       Foreground="{StaticResource MediaForgeMutedBrush}" HorizontalAlignment="Right" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Padding="11,7" CornerRadius="10" Background="#182A21"
                                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverterFallback}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource MediaForgePendingBrush}" VerticalAlignment="Center" />
                                    <TextBlock Margin="7,0,0,0" FontSize="11">
                                        <Run Text="{Binding PendingCount}" />
                                        <Run Text=" שינויים ממתינים" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Button Content="שמור שינויים" Command="{Binding SaveChangesCommand}"
                                    IsEnabled="{Binding HasPendingChanges}"
                                    Margin="10,0,0,0" MinHeight="42"
                                    Style="{StaticResource MediaForgePrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,22,0,0" Background="#12151A" CornerRadius="14" Padding="22">
                        <ContentControl Content="{Binding CurrentPage}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="4,5">
            <TextBlock Text="MediaForge • Windows 11" FontSize="10" Foreground="#6F7783" VerticalAlignment="Center" />
            <TextBlock Text="Save Changes הוא השלב היחיד שמבצע שינויים בדיסק"
                       HorizontalAlignment="Right" FontSize="10" Foreground="#6F7783" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ui:FluentWindow>
