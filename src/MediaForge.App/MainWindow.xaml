<Window x:Class="MediaForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
        xmlns:views="clr-namespace:MediaForge.App.Views"
        Title="MediaForge"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8"
        Foreground="{StaticResource MediaForgeTextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="12"
            Background="#FFFFFF"
            BorderBrush="#D9E2EC"
            BorderThickness="1"
            CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E3EAF1"
                    BorderThickness="0,0,0,1"
                    CornerRadius="22,22,0,0">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Image Width="44"
                               Height="44"
                               Source="{StaticResource MediaForgeIconImage}"
                               Stretch="Uniform"/>
                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="MediaForge"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#12233D"/>
                            <TextBlock Text="Media, organized."
                                       Margin="0,2,0,0"
                                       FontSize="9.5"
                                       Foreground="#8491A4"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Padding="12,8"
                                Background="#F2F8F5"
                                BorderBrush="#D4EBDD"
                                BorderThickness="1"
                                CornerRadius="11">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{StaticResource MediaForgeSuccessBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="עדכונים דרך Microsoft Store"
                                           Margin="7,0,0,0"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#2A7655"/>
                            </StackPanel>
                        </Border>

                        <Button Content="⚙"
                                Command="{Binding NavigateSettingsCommand}"
                                ToolTip="הגדרות"
                                Margin="9,0,0,0"
                                Width="42"
                                Height="42"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource MediaForgeBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>

            <Border Grid.Row="2"
                    Background="#F8FAFD"
                    BorderBrush="#E5EBF2"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,22,22">
                <Grid Margin="22,0">
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="#6E7D91"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="MediaForge"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="9.5"
                               Foreground="#A0AAB8"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>