<Window x:Class="MediaForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
        xmlns:views="clr-namespace:MediaForge.App.Views"
        Title="MediaForge"
        Icon="{StaticResource MediaForgeIconImage}"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        Foreground="{StaticResource MediaForgeTextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <DrawingImage x:Key="MediaForgeIconImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#07122D">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Thickness="8" LineJoin="Round">
                                <Pen.Brush>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#32E7F4" Offset="0"/>
                                        <GradientStop Color="#2678FF" Offset="0.52"/>
                                        <GradientStop Color="#B43CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Pen.Brush>
                            </Pen>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="13,47">
                                    <LineSegment Point="13,21"/>
                                    <LineSegment Point="32,39"/>
                                    <LineSegment Point="51,21"/>
                                    <LineSegment Point="51,47"/>
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#32E7F4" Offset="0"/>
                                <GradientStop Color="#2E7BFF" Offset="0.55"/>
                                <GradientStop Color="#B43CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="26,39" IsClosed="True">
                                    <LineSegment Point="26,50"/>
                                    <LineSegment Point="40,44.5"/>
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage/>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="10"
            Background="#FFFFFF"
            BorderBrush="#DDE5EE"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E3E9F0"
                    BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Image Width="34"
                               Height="34"
                               Source="{StaticResource MediaForgeIconImage}"
                               Stretch="Uniform"/>
                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="MediaForge"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1C2B40"/>
                            <TextBlock Text="Media workspace"
                                       Margin="0,1,0,0"
                                       FontSize="9.5"
                                       Foreground="#8B97A8"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource MediaForgeSuccessBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="מוכן"
                                   Margin="7,0,0,0"
                                   FontSize="10.5"
                                   Foreground="#587087"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>
    </Border>
</Window>
