<ui:FluentWindow x:Class="MediaForge.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
                 xmlns:views="clr-namespace:MediaForge.App.Views"
                 Title="MediaForge"
                 Width="1480"
                 Height="900"
                 MinWidth="1120"
                 MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource MediaForgeBackgroundBrush}"
                 Foreground="{StaticResource MediaForgeTextBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <ui:TitleBar Title="MediaForge"
                     Height="50"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Fluent24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Margin="10,56,10,10"
                Background="#FFFFFF"
                BorderBrush="#DEE5EE"
                BorderThickness="1"
                CornerRadius="20">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <!-- Add media modal -->
        <Grid Panel.ZIndex="100"
              Visibility="{Binding IsMediaDialogOpen, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
              Background="#4D182338">

            <Border Width="820"
                    Height="590"
                    MaxWidth="900"
                    MaxHeight="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22">

                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="הוסף מדיה"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#172338"/>
                            <TextBlock Text="שיר בודד או playlist — הכול יתווסף יחד לשינויים הממתינים."
                                       Margin="0,6,0,0"
                                       FontSize="10.5"
                                       Foreground="#758297"/>
                            <TextBlock Text="{Binding Downloads.DestinationDirectory}"
                                       Margin="0,4,0,0"
                                       FontSize="9.5"
                                       Foreground="#9AA5B4"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Downloads.DestinationDirectory}"/>
                        </StackPanel>
                        <Button Content="✕"
                                Command="{Binding CloseMediaDialogCommand}"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,10"
                            Background="#F8FAFD"
                            BorderBrush="#E0E7EF"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="8">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Downloads.SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MediaForgeInputStyle}"
                                 ToolTip="קישור YouTube או playlist"/>

                            <Button Grid.Column="1"
                                    Content="בדוק קישור"
                                    Command="{Binding Downloads.ResolveCommand}"
                                    Margin="10,0,0,0"
                                    MinWidth="116"
                                    Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Downloads.CollectionTitle}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Downloads.StatusText}"
                                           Margin="0,3,0,0"
                                           FontSize="9.5"
                                           Foreground="#6F7E92"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Downloads.SelectedCount, StringFormat={}{0} שירים נבחרו}"
                                           Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="{StaticResource MediaForgeAccentBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <ComboBox ItemsSource="{Binding Downloads.Formats}"
                                          SelectedItem="{Binding Downloads.SelectedFormat}"
                                          Width="105"
                                          Style="{StaticResource MediaForgeComboStyle}"/>
                                <Button Content="בחר הכול"
                                        IsEnabled="{Binding Downloads.HasItems}"
                                        Command="{Binding Downloads.SelectAllCommand}"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                                <Button Content="MP3 לכולם"
                                        Command="{Binding Downloads.Mp3ToAllCommand}"
                                        IsEnabled="{Binding Downloads.HasItems}"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Background="#F8FAFD"
                                BorderBrush="#E1E8F0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="7">
                            <Grid>
                                <ListView ItemsSource="{Binding Downloads.Items}"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,5"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#E1E7EF"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="9">
                                                <Grid MinHeight="66">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="58"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="78"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>

                                                    <Border Grid.Column="1"
                                                            Width="48"
                                                            Height="48"
                                                            CornerRadius="9"
                                                            Background="#EDF4FF"
                                                            ClipToBounds="True"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding ThumbnailUrl}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2"
                                                                Margin="11,0"
                                                                VerticalAlignment="Center">
                                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MediaForgePathBoxStyle}"
                                                                 FontSize="12.5"
                                                                 FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Artist}"
                                                                   Margin="5,2,0,0"
                                                                   FontSize="9.5"
                                                                   Foreground="#7A8799"/>
                                                    </StackPanel>

                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding Formats}"
                                                              SelectedItem="{Binding DesiredFormat}"
                                                              Style="{StaticResource MediaForgeComboStyle}"
                                                              Height="38"
                                                              Margin="3,0"/>

                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding DurationText}"
                                                               FontSize="9.5"
                                                               Foreground="#7D899C"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Border Visibility="{Binding Downloads.HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        Background="#F8FAFD"
                                        CornerRadius="10">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="62"
                                                Height="62"
                                                CornerRadius="20"
                                                Background="#EDF4FF">
                                            <TextBlock Text="♫"
                                                       FontSize="25"
                                                       Foreground="{StaticResource MediaForgeAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="הדבק קישור למעלה"
                                                   Margin="0,12,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="בדוק את הקישור כדי להציג את המדיה"
                                                   Margin="0,5,0,0"
                                                   FontSize="10"
                                                   Foreground="#8692A4"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3"
                          Margin="0,12,0,0">
                        <TextBlock Text="{Binding Downloads.DestinationDirectory}"
                                   FontSize="10"
                                   Foreground="#738096"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="650"
                                   HorizontalAlignment="Right"
                                   ToolTip="{Binding Downloads.DestinationDirectory}"/>
                        <Button Content="הוסף שירים"
                                Command="{Binding Downloads.StageSelectedCommand}"
                                IsEnabled="{Binding Downloads.HasSelection}"
                                MinWidth="130"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
