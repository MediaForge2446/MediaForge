<ui:FluentWindow x:Class="MediaForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
        xmlns:views="clr-namespace:MediaForge.App.Views"
        Title="{DynamicResource App_Title}"
        Icon="Assets/MediaForge.png"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     Icon="pack://application:,,,/Assets/MediaForge.png"/>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        CornerRadius="12"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                    <Image Source="{StaticResource MediaForgeIconImage}"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,2,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ui:Button Grid.Column="3"
                           Content="{DynamicResource Nav_Home}"
                           Command="{Binding NavigateHomeCommand}"
                           Appearance="Secondary"
                           Height="38"
                           MinWidth="96">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Home24"/>
                    </ui:Button.Icon>
                </ui:Button>

                <Border Grid.Column="5"
                        Padding="12,7"
                        CornerRadius="12"
                        Background="{StaticResource MediaForgeAccentSoftBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PendingCount, StringFormat={}{0} pending}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <ui:Button Grid.Column="7"
                           Content="{DynamicResource Common_SaveChanges}"
                           Command="{Binding SaveChangesCommand}"
                           IsEnabled="{Binding HasPendingChanges}"
                           Appearance="Primary"
                           Height="38"
                           MinWidth="116"
                           HorizontalAlignment="Left"/>

                <ui:Button Grid.Column="9"
                           Content="{DynamicResource Common_Settings}"
                           Command="{Binding NavigateSettingsCommand}"
                           Appearance="Secondary"
                           Height="38"
                           MinWidth="104">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Settings24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="14,12,14,10"
                CornerRadius="18"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="9.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PendingCount, StringFormat={}{0} pending}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="9.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
