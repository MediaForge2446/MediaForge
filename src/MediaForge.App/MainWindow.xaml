<Window x:Class="MediaForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
        xmlns:views="clr-namespace:MediaForge.App.Views"
        Title="MediaForge"
        Icon="/MediaForge.App;component/Assets/MediaForge.ico"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        Foreground="{StaticResource MediaForgeTextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage/>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="10"
            Background="#FFFFFF"
            BorderBrush="#DDE5EE"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E3E9F0"
                    BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Image Width="34"
                               Height="34"
                               Source="/MediaForge.App;component/Assets/MediaForge.png"
                               Stretch="Uniform"/>
                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="MediaForge"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1C2B40"/>
                            <TextBlock Text="Media workspace"
                                       Margin="0,1,0,0"
                                       FontSize="9.5"
                                       Foreground="#8B97A8"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource MediaForgeSuccessBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="מוכן"
                                   Margin="7,0,0,0"
                                   FontSize="10.5"
                                   Foreground="#587087"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>
    </Border>
</Window>
