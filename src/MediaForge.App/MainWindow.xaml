<ui:FluentWindow x:Class="MediaForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
        xmlns:views="clr-namespace:MediaForge.App.Views"
        Title="{DynamicResource App_Title}"
        Icon="Assets/MediaForge.png"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:LibraryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     Icon="pack://application:,,,/Assets/MediaForge.png"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="14,18">
                    <Border Padding="12"
                            CornerRadius="14"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="38"
                                   Height="38"
                                   Source="{StaticResource MediaForgeIconImage}"
                                   Stretch="Uniform"/>
                            <StackPanel Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource App_Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource App_Tagline}"
                                           Margin="0,2,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Nav_Home}"
                               Margin="6,24,6,7"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <ui:Button Content="{DynamicResource Nav_Home}"
                               Appearance="Secondary"
                               Command="{Binding NavigateHomeCommand}"
                               HorizontalAlignment="Stretch"
                               Height="42">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Home24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Content="{DynamicResource Nav_Explorer}"
                               Appearance="Secondary"
                               Command="{Binding NavigateExplorerCommand}"
                               HorizontalAlignment="Stretch"
                               Height="42"
                               Margin="0,6,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{DynamicResource Nav_Downloads}"
                               Appearance="Secondary"
                               Command="{Binding NavigateDownloadsCommand}"
                               HorizontalAlignment="Stretch"
                               Height="42"
                               Margin="0,6,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Content="{DynamicResource Nav_Settings}"
                               Appearance="Secondary"
                               Command="{Binding NavigateSettingsCommand}"
                               HorizontalAlignment="Stretch"
                               Height="42"
                               Margin="0,6,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <Border Margin="0,20,0,0"
                            Padding="12"
                            CornerRadius="12"
                            Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Common_SaveChanges}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PendingCount, StringFormat={}{0} pending}"
                                       Margin="0,3,0,10"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button Content="{DynamicResource Common_SaveChanges}"
                                       Appearance="Primary"
                                       Command="{Binding SaveChangesCommand}"
                                       IsEnabled="{Binding HasPendingChanges}"
                                       HorizontalAlignment="Stretch"
                                       Height="38">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="{DynamicResource Common_Discard}"
                                       Appearance="Secondary"
                                       Command="{Binding DiscardPendingChangesCommand}"
                                       IsEnabled="{Binding HasPendingChanges}"
                                       HorizontalAlignment="Stretch"
                                       Height="36"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="10"
                            CornerRadius="10"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="28,22,32,16"
                        Background="Transparent">
                    <Grid>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PageTitle}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <ui:Button Content="{DynamicResource Common_Settings}"
                                   Command="{Binding NavigateSettingsCommand}"
                                   Appearance="Secondary"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Height="38">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Settings24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="18,0,18,18"
                        CornerRadius="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="9"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PendingCount, StringFormat={}{0} pending}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="9"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
