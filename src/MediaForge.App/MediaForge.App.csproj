<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MediaForge</AssemblyName>
    <RootNamespace>MediaForge.App</RootNamespace>
    <ApplicationIcon>Assets\MediaForge.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="PrepareBrandingAssets" BeforeTargets="PrepareResources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\PrepareBranding.ps1&quot; -RepositoryRoot &quot;$(MSBuildProjectDirectory)\..\..&quot;" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\MediaForge.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MediaForge.Core\MediaForge.Core.csproj" />
    <ProjectReference Include="..\MediaForge.Application\MediaForge.Application.csproj" />
    <ProjectReference Include="..\MediaForge.Infrastructure\MediaForge.Infrastructure.csproj" />
  </ItemGroup>
</Project>
