<Window x:Class="MediaForge.App.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הוסף מדיה"
        Width="900"
        Height="660"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="#F3F6FA"
        FlowDirection="RightToLeft">

    <Border Margin="8"
            Background="#FFFFFF"
            BorderBrush="#D9E2EC"
            BorderThickness="1"
            CornerRadius="20">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="הוסף מדיה"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#172338"/>
                    <TextBlock Text="שיר בודד או playlist. ההוספה תופיע מיד כשינוי ממתין."
                               Margin="0,5,0,0"
                               FontSize="10.5"
                               Foreground="#758297"/>
                    <TextBlock Text="{Binding DestinationDirectory}"
                               Margin="0,5,0,0"
                               FontSize="9.5"
                               Foreground="#9AA5B4"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DestinationDirectory}"/>
                </StackPanel>
                <Button Content="סגור"
                        Click="CloseButton_OnClick"
                        MinWidth="72"
                        Height="38"
                        HorizontalAlignment="Left"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,14"
                    Background="#F8FAFD"
                    BorderBrush="#E0E7EF"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="122"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MediaForgeInputStyle}"
                             ToolTip="קישור YouTube או playlist"/>
                    <Button Grid.Column="1"
                            Content="בדוק קישור"
                            Command="{Binding ResolveCommand}"
                            Margin="10,0,0,0"
                            MinWidth="112"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CollectionTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#748196"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ComboBox ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding SelectedFormat}"
                                  Width="108"
                                  Style="{StaticResource MediaForgeComboStyle}"/>
                        <Button Content="בחר הכול"
                                Command="{Binding SelectAllCommand}"
                                IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                        <Button Content="MP3 לכולם"
                                Command="{Binding Mp3ToAllCommand}"
                                IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="#F8FAFD"
                        BorderBrush="#E1E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8">
                    <Grid>
                        <ListView ItemsSource="{Binding Items}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E0E7EF"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="10">
                                        <Grid MinHeight="68">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                            <Border Grid.Column="1"
                                                    Width="48"
                                                    Height="48"
                                                    CornerRadius="9"
                                                    Background="#EDF4FF"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        Margin="11,0"
                                                        VerticalAlignment="Center">
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource MediaForgeInputStyle}"
                                                         MinHeight="36"
                                                         FontSize="12"
                                                         Padding="9,0"/>
                                                <TextBlock Text="{Binding Artist}"
                                                           Margin="4,3,0,0"
                                                           FontSize="9.5"
                                                           Foreground="#7A8799"/>
                                            </StackPanel>

                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{Binding Formats}"
                                                      SelectedItem="{Binding DesiredFormat}"
                                                      Style="{StaticResource MediaForgeComboStyle}"
                                                      Height="38"
                                                      Margin="3,0"/>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding DurationText}"
                                                       FontSize="9.5"
                                                       Foreground="#7D899C"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="#F8FAFD"
                                CornerRadius="11">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="64"
                                        Height="64"
                                        CornerRadius="20"
                                        Background="#EDF4FF">
                                    <TextBlock Text="♫"
                                               FontSize="26"
                                               Foreground="{StaticResource MediaForgeAccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="הדבק קישור למעלה"
                                           Margin="0,11,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="בדוק את הקישור כדי להציג את השיר או ה־playlist."
                                           Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="#8794A6"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                Background="#CCFFFFFF"
                                CornerRadius="11">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="230"
                                             Height="4"/>
                                <TextBlock Text="טוען פרטי מדיה…"
                                           Margin="0,11,0,0"
                                           FontSize="10.5"
                                           Foreground="#607086"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="יעד"
                               FontSize="9.5"
                               Foreground="#7A879A"/>
                    <TextBlock Text="{Binding DestinationDirectory}"
                               Margin="0,3,0,0"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#3B4A60"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="660"/>
                </StackPanel>
                <Button Content="הוסף שירים"
                        Command="{Binding StageSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        MinWidth="132"
                        Height="42"
                        HorizontalAlignment="Left"
                        Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>