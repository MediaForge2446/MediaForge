<Window x:Class="MediaForge.App.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הוסף מדיה"
        Width="960"
        Height="700"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="#EEF3F8"
>

    <Border Margin="10"
            Background="#FFFFFF"
            BorderBrush="#D9E3EC"
            BorderThickness="1"
            CornerRadius="20">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="34"
                               Height="34"
                               Source="{StaticResource MediaForgeIconImage}"
                               VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="הוסף מדיה"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#16263D"/>
                            <TextBlock Text="שיר בודד או playlist · הכול מתווסף כטיוטה לפני השמירה"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="#7A8799"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Content="סגור"
                        Click="CloseButton_OnClick"
                        MinWidth="74"
                        Height="38"
                        HorizontalAlignment="Left"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F7FAFD"
                    BorderBrush="#DFE7EF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="126"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MediaForgeInputStyle}"
                             ToolTip="קישור YouTube או playlist"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="הדבק"
                            Click="PasteButton_OnClick"
                            Margin="8,0,0,0"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    <Button Grid.Column="2"
                            Content="בדוק קישור"
                            Command="{Binding ResolveCommand}"
                            Margin="8,0,0,0"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CollectionTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#26364D"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#7C899B"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Border Padding="10,7"
                                Background="#F0F6FF"
                                BorderBrush="#D9E7FB"
                                BorderThickness="1"
                                CornerRadius="9"
                                VerticalAlignment="Center">
                            <TextBlock Text="MP3 ברירת מחדל · 128 kbps"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#3266A9"/>
                        </Border>
                        <ComboBox ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding SelectedFormat}"
                                  Width="108"
                                  Margin="8,0,0,0"
                                  Style="{StaticResource MediaForgeComboStyle}"/>
                        <Button Content="בחר הכול"
                                Command="{Binding SelectAllCommand}"
                                IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                        <Button Content="MP3 לכולם"
                                Command="{Binding Mp3ToAllCommand}"
                                IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="#FAFCFE"
                        BorderBrush="#E0E7EF"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="8">
                    <Grid>
                        <ListView ItemsSource="{Binding Items}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E0E8F0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10">
                                        <Grid MinHeight="72">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="116"/>
                                                <ColumnDefinition Width="94"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>

                                            <Border Grid.Column="1"
                                                    Width="50"
                                                    Height="50"
                                                    CornerRadius="10"
                                                    Background="#EDF4FF"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding ThumbnailUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        Margin="11,0,15,0"
                                                        VerticalAlignment="Center">
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource MediaForgeInlineInputStyle}"/>
                                                <TextBlock Text="{Binding Artist}"
                                                           Margin="4,4,0,0"
                                                           FontSize="9.5"
                                                           Foreground="#7C899B"/>
                                            </StackPanel>

                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{Binding Formats}"
                                                      SelectedItem="{Binding DesiredFormat}"
                                                      Style="{StaticResource MediaForgeComboStyle}"
                                                      Height="38"
                                                      Margin="2,0"/>

                                            <StackPanel Grid.Column="4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DurationText}"
                                                           FontSize="9.5"
                                                           Foreground="#7A8799"
                                                           HorizontalAlignment="Center"/>
                                                <Border Margin="0,6,0,0"
                                                        Padding="7,3"
                                                        Background="#F2F8F5"
                                                        CornerRadius="7">
                                                    <TextBlock Text="מוכן"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2A7856"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="#FAFCFE"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="420">
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="22"
                                        Background="#0B1833">
                                    <Image Width="54"
                                           Height="54"
                                           Source="{StaticResource MediaForgeIconImage}"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="הדבק קישור כדי להתחיל"
                                           Margin="0,14,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#27374E"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="אפשר שיר אחד או playlist. אחרי הבדיקה תוכל לבחור אילו פריטים להוסיף."
                                           Margin="0,6,0,0"
                                           FontSize="10"
                                           Foreground="#8794A6"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                Background="#DFFFFFFF"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="230"
                                             Height="4"
                                             IsIndeterminate="True"/>
                                <TextBlock Text="מביא פרטי מדיה…"
                                           Margin="0,11,0,0"
                                           FontSize="10.5"
                                           Foreground="#69798E"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="יעד"
                               FontSize="9.5"
                               Foreground="#7C899B"/>
                    <TextBlock Text="{Binding DestinationDirectory}"
                               Margin="0,3,0,0"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#3B4A60"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="690"
                               ToolTip="{Binding DestinationDirectory}"/>
                </StackPanel>

                <Button Content="הוסף שירים"
                        Command="{Binding StageSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        MinWidth="142"
                        Height="42"
                        HorizontalAlignment="Left"
                        Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
