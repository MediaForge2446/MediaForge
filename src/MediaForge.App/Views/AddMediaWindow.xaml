<ui:FluentWindow x:Class="MediaForge.App.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource AddMedia_Title}"
        Width="1060"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <Style x:Key="FormatChoiceStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentControlFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource AddMedia_Title}"
                     Icon="pack://application:,,,/Assets/MediaForge.png"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,30">

                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource AddMedia_Title}"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource AddMedia_Subtitle}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ui:Card Margin="0,22,0,0"
                         Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="116"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{DynamicResource AddMedia_UrlPlaceholder}"
                                    Icon="{ui:SymbolIcon Link24}"
                                    Height="46"
                                    VerticalContentAlignment="Center"/>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding PasteCommand}"
                                   Appearance="Secondary"
                                   Margin="8,0,0,0"
                                   ToolTip="{DynamicResource AddMedia_Paste}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Clipboard24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Grid.Column="2"
                                   Content="{DynamicResource AddMedia_Resolve}"
                                   Command="{Binding ResolveCommand}"
                                   Appearance="Primary"
                                   Margin="8,0,0,0"
                                   Height="46">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Search24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0"
                             Padding="0"
                             ClipToBounds="True">
                        <Grid>
                            <Border Height="220"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    ClipToBounds="True">
                                <Image Source="{Binding PreviewItem.ThumbnailUrl}"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <Border Margin="14"
                                    Padding="10,7"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#CC111827"
                                    CornerRadius="9">
                                <TextBlock Text="{DynamicResource AddMedia_PreviewBadge}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <StackPanel Margin="18,235,18,18">
                                <TextBlock Text="{Binding PreviewItem.Title}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PreviewItem.Artist}"
                                           Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource AddMedia_Duration}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PreviewItem.DurationText}"
                                               HorizontalAlignment="Left"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <TextBlock Text="{Binding CollectionTitle}"
                                           Margin="0,12,0,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    Opacity="0.97">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="28">
                                    <ui:SymbolIcon Symbol="Link24"
                                                   FontSize="34"
                                                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource AddMedia_EmptyTitle}"
                                               Margin="0,12,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource AddMedia_EmptySubtitle}"
                                               Margin="0,5,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    Opacity="0.93">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True"
                                                     Width="34"
                                                     Height="34"/>
                                    <TextBlock Text="{DynamicResource AddMedia_Resolving}"
                                               Margin="0,12,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="2"
                             Padding="20">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AddMedia_FormatTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource AddMedia_FormatSubtitle}"
                                       Margin="0,5,0,14"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource FormatChoiceStyle}"
                                              Command="{Binding SelectMp3Command}"
                                              IsChecked="{Binding IsMp3Selected, Mode=OneWay}">
                                    <StackPanel>
                                        <TextBlock Text="MP3"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource AddMedia_Mp3Description}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9.5"/>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FormatChoiceStyle}"
                                              Command="{Binding SelectMp4Command}"
                                              IsChecked="{Binding IsMp4Selected, Mode=OneWay}"
                                              Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MP4"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource AddMedia_Mp4Description}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9.5"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource FormatChoiceStyle}"
                                              Command="{Binding SelectWavCommand}"
                                              IsChecked="{Binding IsWavSelected, Mode=OneWay}">
                                    <StackPanel>
                                        <TextBlock Text="WAV"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource AddMedia_WavDescription}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9.5"/>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FormatChoiceStyle}"
                                              Command="{Binding SelectM4aCommand}"
                                              IsChecked="{Binding IsM4aSelected, Mode=OneWay}"
                                              Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="M4A"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource AddMedia_M4aDescription}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9.5"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <Border Margin="0,16,0,0"
                                    Padding="12"
                                    Background="{DynamicResource LayerFillColorAltBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AddMedia_QueueBehaviorTitle}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource AddMedia_QueueBehaviorDescription}"
                                               Margin="0,4,0,0"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,14,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0"
                                           Content="{DynamicResource Downloads_SelectAll}"
                                           Command="{Binding SelectAllCommand}"
                                           Appearance="Secondary"
                                           Height="40"/>

                                <ui:Button Grid.Column="2"
                                           Content="{DynamicResource AddMedia_AddToQueue}"
                                           Command="{Binding StageSelectedCommand}"
                                           IsEnabled="{Binding HasSelection}"
                                           Appearance="Primary"
                                           Height="40">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0"
                                           Content="{DynamicResource AddMedia_ChooseFolder}"
                                           Command="{Binding PickDestinationCommand}"
                                           Appearance="Secondary"
                                           Height="38">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="FolderOpen24"/>
                                    </ui:Button.Icon>
                                </ui:Button>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DestinationDirectory}"
                                           VerticalAlignment="Center"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DestinationDirectory}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <ui:Card Margin="0,16,0,0"
                         Padding="18"
                         Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverterFallback}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding CollectionTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,3,0,0"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <ui:Button Content="{DynamicResource Downloads_Mp3All}"
                                       Command="{Binding Mp3ToAllCommand}"
                                       Appearance="Secondary"
                                       Height="36"/>
                            <ui:Button Content="{DynamicResource AddMedia_SelectAll}"
                                       Command="{Binding SelectAllCommand}"
                                       Appearance="Secondary"
                                       Height="36"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,16,0,0"
                         Padding="10"
                         Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverterFallback}}">
                    <ListView ItemsSource="{Binding Items}"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Width="48"
                                                Height="48"
                                                CornerRadius="9"
                                                ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding ThumbnailUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    Margin="11,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}"
                                                       Margin="0,3,0,0"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DurationText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding DesiredFormat}"
                                                  Height="34"
                                                  FontSize="10.5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ui:Card>

                <ui:Card Margin="0,16,0,0"
                         Padding="14">
                    <DockPanel>
                        <ui:Button Content="{DynamicResource Common_Discard}"
                                   Click="CloseButton_OnClick"
                                   Appearance="Secondary"
                                   HorizontalAlignment="Left"
                                   MinWidth="110"
                                   Height="38"/>
                        <StackPanel DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Downloads_Target}"
                                       HorizontalAlignment="Right"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding DestinationDirectory}"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="600"
                                       ToolTip="{Binding DestinationDirectory}"/>
                        </StackPanel>
                    </DockPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
