<UserControl x:Class="MediaForge.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="DownloadComboStyle" TargetType="ComboBox" BasedOn="{StaticResource MediaForgeComboStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="הורדת מדיה" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="הדבק קישור, בדוק את המדיה, ערוך את הפרטים והוסף לתיקיית יעד." Margin="0,5,0,0" FontSize="13" Foreground="#87919E" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Padding="12,8" CornerRadius="10" Background="#121A20" BorderBrush="#27333C" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MediaForgeSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" מערכת ההורדה מוכנה" Margin="8,0,0,0" FontSize="10" Foreground="#B9C4CD" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="14" Margin="0,0,0,12" Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Padding="0" Background="#0D141A" BorderBrush="#27333C" BorderThickness="1" CornerRadius="10">
                    <TextBlock Text="↗" Width="38" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource MediaForgeAccentBrush}" />
                </Border>

                <TextBox Grid.Column="1"
                         Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0"
                         Style="{StaticResource MediaForgeInputStyle}"
                         ToolTip="קישור YouTube או פלייליסט" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          Style="{StaticResource DownloadComboStyle}"
                          ToolTip="פורמט ברירת מחדל" />

                <Button Grid.Column="3"
                        Content="בדוק והצג"
                        Command="{Binding ResolveCommand}"
                        Margin="8,0,0,0"
                        MinWidth="126"
                        Style="{StaticResource MediaForgePrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14" Margin="0,0,0,10" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CollectionTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" FontSize="11" Foreground="#7E8A95" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="בחר הכול" Command="{Binding SelectAllCommand}" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                        <Button Content="MP3 לכולם" Command="{Binding Mp3ToAllCommand}" Margin="8,0,0,0" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <ListView ItemsSource="{Binding Items}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="8"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" CornerRadius="12" Background="#11171D" BorderBrush="#202A33" BorderThickness="1">
                                    <Grid MinHeight="88">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <Border Grid.Column="1" Width="62" Height="62" CornerRadius="10" Background="#1A232D" ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MediaForgeInlineInputStyle}" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Margin="6,5,0,0">
                                                <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="#7B8792" />
                                                <Ellipse Width="4" Height="4" Margin="8,0" Fill="#46525E" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="#7B8792" />
                                            </StackPanel>
                                        </StackPanel>

                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding DesiredFormat}"
                                                  Style="{StaticResource DownloadComboStyle}"
                                                  VerticalAlignment="Center" />

                                        <Border Grid.Column="4" Padding="10,7" CornerRadius="9" Background="#17222A" BorderBrush="#25323A" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource MediaForgeSuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="מוכן" Margin="7,0,0,0" FontSize="10" Foreground="#A9B7C1" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Background="#0C1116" CornerRadius="14" Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <Border Width="78" Height="78" CornerRadius="24" Background="#12232B" BorderBrush="#203A46" BorderThickness="1">
                                <TextBlock Text="↗" FontSize="32" Foreground="{StaticResource MediaForgeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="מוכן לקבלת קישור" Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="הדבק קישור למעלה ולחץ על ‘בדוק והצג’. ניתן להוסיף שיר בודד או פלייליסט שלם." Margin="0,8,0,0" FontSize="11" Foreground="#737F8B" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#071015" Opacity="0.72" CornerRadius="14" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                            <TextBlock Text="מביא נתוני מדיה…" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="#CDD6DD" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="14" Margin="0,12,0,0" Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="תיקיית יעד" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DestinationDirectory}" Margin="0,4,0,0" FontSize="10.5" Foreground="#778390" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="בחר תיקייה" Command="{Binding PickDestinationCommand}" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                <Button Grid.Column="2" Content="הוסף לשינויים  →" Command="{Binding StageSelectedCommand}" Margin="8,0,0,0" Style="{StaticResource MediaForgePrimaryButtonStyle}" MinWidth="160" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
