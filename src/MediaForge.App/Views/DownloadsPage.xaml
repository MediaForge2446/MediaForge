<UserControl x:Class="MediaForge.App.Views.DownloadsPage"
             x:Name="QueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
             Background="Transparent">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Downloads_Title}"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Downloads_Subtitle}"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <ui:Card Padding="14,10"
                         Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding QueueCount}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Downloads_Queue}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="14,10"
                         Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveQueueCount}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Downloads_Active}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{Binding QueuedCount}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Downloads_Pending}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="2"
                 Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,0"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 ToolTip="{DynamicResource Downloads_PastePrompt}"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          Height="42"
                          Margin="0,0,8,0"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Qualities}"
                          SelectedItem="{Binding SelectedQuality}"
                          Height="42"
                          Margin="0,0,8,0"/>

                <ui:Button Grid.Column="3"
                           Content="{DynamicResource Downloads_Resolve}"
                           Command="{Binding ResolveCommand}"
                           Appearance="Primary"
                           Height="42">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="6,4,6,10">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Downloads_Queue}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,3,0,0"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Border Padding="9,6"
                                    Background="{DynamicResource LayerFillColorAltBrush}"
                                    CornerRadius="8"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Downloads_Concurrency}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DataContext.DownloadQueueConcurrency, ElementName=QueuePage}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <ui:Button Content="{DynamicResource Downloads_SelectAll}"
                                       Command="{Binding SelectAllCommand}"
                                       IsEnabled="{Binding HasItems}"
                                       Appearance="Secondary"
                                       Height="34"/>
                            <ui:Button Content="{DynamicResource Downloads_Mp3All}"
                                       Command="{Binding Mp3ToAllCommand}"
                                       IsEnabled="{Binding HasItems}"
                                       Appearance="Secondary"
                                       Height="34"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView x:Name="QueueList"
                                  ItemsSource="{Binding QueueItems}"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="QueueList_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="QueueList_OnPreviewMouseMove"
                                  Drop="QueueList_OnDrop"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DownloadQueueItemViewModel}">
                                    <Border Padding="12"
                                            CornerRadius="14"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="136"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="⋮⋮"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"/>

                                            <Border Grid.Column="1"
                                                    Width="56"
                                                    Height="56"
                                                    CornerRadius="12"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    VerticalAlignment="Top">
                                                <Image Source="{Binding ThumbnailUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        Margin="12,0,16,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border DockPanel.Dock="Right"
                                                            Padding="7,3"
                                                            Margin="8,0,0,0"
                                                            Background="{DynamicResource LayerFillColorAltBrush}"
                                                            CornerRadius="6">
                                                        <TextBlock Text="{Binding FormatText}"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                </DockPanel>

                                                <TextBlock Text="{Binding Artist}"
                                                           Margin="0,3,0,0"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,7,0,0">
                                                    <TextBlock Text="{Binding QualityText}"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding DownloadedSizeText}"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text=" / "
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>

                                                <ProgressBar Margin="0,10,0,0"
                                                             Height="6"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercent}"/>

                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Margin="0,5,0,0"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Top">
                                                <TextBlock Text="{DynamicResource Downloads_Speed}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding SpeedText}"
                                                           Margin="0,2,0,8"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource Downloads_Eta}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding EtaText}"
                                                           Margin="0,2,0,8"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource Downloads_Size}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding SizeText}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                <ui:Button Content="{DynamicResource Downloads_Pause}"
                                                           Command="{Binding DataContext.PauseQueueItemCommand, ElementName=QueuePage}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding CanPause}"
                                                           Appearance="Secondary"
                                                           Height="32"
                                                           Margin="0,0,5,0"/>
                                                <ui:Button Content="{DynamicResource Downloads_Resume}"
                                                           Command="{Binding DataContext.ResumeQueueItemCommand, ElementName=QueuePage}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding CanResume}"
                                                           Appearance="Secondary"
                                                           Height="32"
                                                           Margin="0,0,5,0"/>
                                                <ui:Button Content="{DynamicResource Downloads_Retry}"
                                                           Command="{Binding DataContext.RetryQueueItemCommand, ElementName=QueuePage}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding CanRetry}"
                                                           Appearance="Primary"
                                                           Height="32"
                                                           Margin="0,0,5,0"/>
                                                <ui:Button Content="⋯"
                                                           ToolTip="{DynamicResource Downloads_ShowLog}"
                                                           Command="{Binding DataContext.ShowQueueLogCommand, ElementName=QueuePage}"
                                                           CommandParameter="{Binding}"
                                                           Height="32"
                                                           MinWidth="34"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3"
                                                        Grid.Column="2"
                                                        Grid.ColumnSpan="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,10,0,0">
                                                <ui:Button Content="{DynamicResource Downloads_Cancel}"
                                                           Command="{Binding DataContext.CancelQueueItemCommand, ElementName=QueuePage}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding CanCancel}"
                                                           Appearance="Secondary"
                                                           Height="30"
                                                           MinWidth="82"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasQueue, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="{DynamicResource LayerFillColorAltBrush}"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="380">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               FontSize="52"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Downloads_QueueEmptyTitle}"
                                           Margin="0,14,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Downloads_QueueEmptySubtitle}"
                                           Margin="0,6,0,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2"
                     Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AddMedia_PreviewTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AddMedia_PreviewSubtitle}"
                                   Margin="0,5,0,14"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <Border Height="190"
                                CornerRadius="14"
                                ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Image Source="{Binding PreviewItem.ThumbnailUrl}"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Text="{Binding PreviewItem.Title, TargetNullValue=—}"
                                   Margin="0,12,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PreviewItem.Artist}"
                                   Margin="0,4,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding PreviewItem.DurationText}"
                                   Margin="0,3,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                        <Border Margin="0,16,0,0"
                                Padding="12"
                                Background="{DynamicResource LayerFillColorAltBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Downloads_Destination}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding DestinationDirectory, TargetNullValue=—}"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DestinationDirectory}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0"
                                       Content="{DynamicResource Downloads_PickFolder}"
                                       Command="{Binding PickDestinationCommand}"
                                       Appearance="Secondary"
                                       Height="38"/>
                            <ui:Button Grid.Column="2"
                                       Content="{DynamicResource Downloads_AddToChanges}"
                                       Command="{Binding StageSelectedCommand}"
                                       IsEnabled="{Binding HasSelection}"
                                       Appearance="Primary"
                                       Height="38"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,12,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
