<UserControl x:Class="MediaForge.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ההורדות שלי" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="הדבק קישור, בדוק את המדיה, ערוך את השמות ושמור הכול כשינוי אחד מסודר."
                       Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MediaForgeMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,16" Padding="16" Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MediaForgeInputStyle}"
                         MinHeight="42"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="בדוק קישור" Command="{Binding ResolveCommand}"
                        Margin="10,0,0,0" Style="{StaticResource MediaForgePrimaryButtonStyle}" />
                <ComboBox Grid.Column="2" Width="125" Margin="10,0,0,0"
                          ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                          Style="{StaticResource MediaForgeComboStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14" Margin="0,0,0,12" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CollectionTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MediaForgeMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="בחר הכול" Command="{Binding SelectAllCommand}" CommandParameter="True" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                        <Button Content="MP3 לכולם" Command="{Binding Mp3ToAllCommand}" Margin="8,0,0,0" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MediaForgeCardStyle}">
                <ListView ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" Padding="6">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6" MinHeight="74">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="10" Background="#202832">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MediaForgeInlineInputStyle}" />
                                    <TextBlock Text="{Binding Artist}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MediaForgeMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{StaticResource MediaForgeMutedBrush}" Margin="12,0,12,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="תיקיית יעד" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DestinationDirectory}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MediaForgeMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="בחר תיקייה" Command="{Binding PickDestinationCommand}" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                        <Button Content="＋ הוסף לשינויים" Command="{Binding StageSelectedCommand}"
                                Margin="8,0,0,0" Style="{StaticResource MediaForgePrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
