<UserControl x:Class="MediaForge.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="DownloadComboStyle" TargetType="ComboBox" BasedOn="{StaticResource MediaForgeComboStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,30,40,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="הורדת מדיה"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#15263D"/>
                <TextBlock Text="בדוק שיר או playlist, בחר פורמט והוסף הכול לשינויים הממתינים."
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#7C899B"/>
            </StackPanel>
            <Border HorizontalAlignment="Left"
                    Padding="11,8"
                    Background="#F1F7F4"
                    BorderBrush="#D5EBDD"
                    BorderThickness="1"
                    CornerRadius="11"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource MediaForgeSuccessBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="מערכת ההורדה מוכנה"
                               Margin="7,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#2B7655"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="128"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MediaForgeInputStyle}"
                         ToolTip="קישור YouTube או playlist"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          Margin="9,0,0,0"
                          Style="{StaticResource DownloadComboStyle}"/>
                <Button Grid.Column="2"
                        Content="בדוק והצג"
                        Command="{Binding ResolveCommand}"
                        Margin="9,0,0,0"
                        Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="12"
                Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CollectionTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#27384F"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#7D8A9C"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Border Padding="9,6"
                                Background="#F0F6FF"
                                CornerRadius="9">
                            <TextBlock Text="MP3 · 128 kbps"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#3266A9"/>
                        </Border>
                        <Button Content="בחר הכול"
                                Command="{Binding SelectAllCommand}"
                                IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                        <Button Content="MP3 לכולם"
                                Command="{Binding Mp3ToAllCommand}"
                                IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView ItemsSource="{Binding Items}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Background="#FFFFFF"
                                        BorderBrush="#E1E9F1"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Width="50"
                                                Height="50"
                                                CornerRadius="10"
                                                Background="#EDF4FF"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding ThumbnailUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="2"
                                                    Margin="10,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MediaForgeInlineInputStyle}"/>
                                            <TextBlock Text="{Binding Artist}"
                                                       Margin="4,4,0,0"
                                                       FontSize="9.5"
                                                       Foreground="#7C899B"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding DesiredFormat}"
                                                  Style="{StaticResource DownloadComboStyle}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding DurationText}"
                                                   FontSize="9.5"
                                                   Foreground="#7C899B"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Background="#FBFCFE"
                            CornerRadius="11">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Image Width="70"
                                   Height="70"
                                   Source="{StaticResource MediaForgeIconImage}"/>
                            <TextBlock Text="מוכן לקבלת קישור"
                                       Margin="0,12,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="הדבק קישור ולחץ על 'בדוק והצג'."
                                       Margin="0,5,0,0"
                                       FontSize="10.5"
                                       Foreground="#8794A6"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                            Background="#DFFFFFFF"
                            CornerRadius="11">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ProgressBar Width="230"
                                         Height="4"
                                         IsIndeterminate="True"/>
                            <TextBlock Text="מביא נתוני מדיה…"
                                       Margin="0,11,0,0"
                                       FontSize="10.5"
                                       Foreground="#6B7A8F"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Padding="13"
                Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="תיקיית יעד"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#6F7D91"/>
                    <TextBlock Text="{Binding DestinationDirectory}"
                               Margin="0,4,0,0"
                               FontSize="10.5"
                               Foreground="#3A4A61"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="בחר תיקייה"
                            Command="{Binding PickDestinationCommand}"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    <Button Content="הוסף לשינויים"
                            Command="{Binding StageSelectedCommand}"
                            Margin="8,0,0,0"
                            MinWidth="150"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>