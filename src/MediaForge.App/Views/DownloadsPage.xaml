<UserControl x:Class="MediaForge.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="הורדת מדיה" FontSize="29" FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Text="הדבק קישור, בדוק את המדיה והכן אותה לשמירה בספרייה." Margin="0,5,0,0"
                           FontSize="13" Foreground="#87919E" HorizontalAlignment="Right" />
            </StackPanel>
            <Border HorizontalAlignment="Left" Padding="11,8" CornerRadius="11" Background="#151F25" BorderBrush="#27333C" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MediaForgeSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" הורדה חכמה · yt-dlp" Margin="8,0,0,0" FontSize="10" Foreground="#AEB8C3" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,22,0,16" Padding="14" Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="↗" FontSize="18" Foreground="{StaticResource MediaForgeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MediaForgeInputStyle}" BorderThickness="0" Background="Transparent"
                             ToolTip="קישור YouTube / playlist" />
                </Grid>
                <Button Grid.Column="1" Content="בדוק והצג" Command="{Binding ResolveCommand}"
                        Margin="10,0,10,0" Style="{StaticResource MediaForgePrimaryButtonStyle}" MinWidth="118" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                          Style="{StaticResource MediaForgeComboStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="15" Margin="0,0,0,12" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CollectionTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" FontSize="11" Foreground="#7F8995" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="בחר הכול" Command="{Binding SelectAllCommand}" CommandParameter="True" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                        <Button Content="MP3 לכולם" Command="{Binding Mp3ToAllCommand}" Margin="8,0,0,0" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MediaForgeCardStyle}">
                <ListView ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" Padding="8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Background="#12171D" CornerRadius="12" BorderBrush="#202832" BorderThickness="1">
                                <Grid MinHeight="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Border Grid.Column="1" Width="52" Height="52" CornerRadius="10" Background="#1A232D">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MediaForgeInlineInputStyle}" />
                                        <TextBlock Text="{Binding Artist}" Margin="6,2,0,0" FontSize="10" Foreground="#75808D" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="11" Foreground="#84909C" />
                                    <Border Grid.Column="4" Padding="8,5" CornerRadius="8" Background="#19232C" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="מוכן" FontSize="10" Foreground="#AFC0CB" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="תיקיית יעד" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DestinationDirectory}" Margin="0,4,0,0" FontSize="10" Foreground="#778390" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="בחר תיקייה" Command="{Binding PickDestinationCommand}" Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                        <Button Content="הוסף לשינויים  →" Command="{Binding StageSelectedCommand}" Margin="8,0,0,0"
                                Style="{StaticResource MediaForgePrimaryButtonStyle}" MinWidth="146" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
