<UserControl x:Class="MediaForge.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MediaForge.App.ViewModels"
             Background="Transparent">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Downloads_Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Downloads_Subtitle}"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <ui:Card Padding="12,8"
                         Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding QueueCount}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Downloads_Queue}"
                                   Margin="0,1,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveQueueCount}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Downloads_Active}"
                                   Margin="0,1,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="2"
                 Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="146"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,0"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 ToolTip="{DynamicResource Downloads_PastePrompt}"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}"
                          Height="42"
                          Margin="0,0,8,0"/>

                <ui:Button Grid.Column="2"
                           Content="{DynamicResource Downloads_Resolve}"
                           Command="{Binding ResolveCommand}"
                           Appearance="Primary"
                           Height="42">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="6,4,6,10">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Downloads_Queue}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,3,0,0"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Border Padding="9,6"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="8"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding QueuedCount, StringFormat={}{0}}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            </Border>
                            <ui:Button Content="{DynamicResource Downloads_SelectAll}"
                                       Command="{Binding SelectAllCommand}"
                                       IsEnabled="{Binding HasItems}"
                                       Appearance="Secondary"
                                       Height="34"/>
                            <ui:Button Content="{DynamicResource Downloads_Mp3All}"
                                       Command="{Binding Mp3ToAllCommand}"
                                       IsEnabled="{Binding HasItems}"
                                       Appearance="Secondary"
                                       Height="34"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{Binding QueueItems}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            CornerRadius="13"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="78"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="56"
                                                    Height="56"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}"
                                                           Margin="0,3,0,0"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,7,0,0">
                                                    <Border Padding="7,3"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource LayerFillColorAltBrush}">
                                                        <TextBlock Text="{Binding Format}"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Downloads_Speed}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding SpeedText}"
                                                           Margin="0,2,0,7"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource Downloads_Eta}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding EtaText}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Margin="0,6,0,0"
                                                         HorizontalAlignment="Right">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DownloadQueueState.Completed}">
                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DownloadQueueState.Failed}">
                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DownloadQueueState.Retrying}">
                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </StackPanel>

                                            <ProgressBar Grid.Row="1"
                                                         Grid.Column="1"
                                                         Grid.ColumnSpan="3"
                                                         Margin="76,12,0,0"
                                                         Height="5"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent}"/>

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="3"
                                                       Margin="76,8,0,0"
                                                       Text="{Binding ErrorMessage}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasQueue, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="{DynamicResource LayerFillColorAltBrush}"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="380">
                                <ui:SymbolIcon Symbol="ArrowDownload24"
                                               FontSize="52"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Downloads_QueueEmptyTitle}"
                                           Margin="0,14,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Downloads_QueueEmptySubtitle}"
                                           Margin="0,6,0,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Opacity="0.94"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True"
                                                 Width="34"
                                                 Height="34"/>
                                <TextBlock Text="{DynamicResource Downloads_Resolving}"
                                           Margin="0,10,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2"
                     Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,4,6,10">
                        <TextBlock Text="{DynamicResource Downloads_Preview}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CollectionTitle}"
                                   Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding ThumbnailUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="9,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     FontSize="10.5"
                                                     FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DurationText}"
                                                       Margin="0,3,0,0"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ui:Card Grid.Row="2"
                             Padding="10"
                             Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Downloads_Target}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding DestinationDirectory}"
                                       Margin="0,3,0,8"
                                       FontSize="9.5"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DestinationDirectory}"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <ui:Button Content="{DynamicResource Downloads_PickFolder}"
                                           Command="{Binding PickDestinationCommand}"
                                           Appearance="Secondary"
                                           Height="36"/>
                                <ui:Button Content="{DynamicResource Downloads_AddToChanges}"
                                           Command="{Binding StageSelectedCommand}"
                                           Appearance="Primary"
                                           IsEnabled="{Binding HasSelection}"
                                           Margin="6,0,0,0"
                                           Height="36"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>