<UserControl x:Class="MediaForge.App.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Explorer_Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Explorer_Subtitle}"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding CurrentPath}"
                           Margin="0,10,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CurrentPath}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <ui:Button Appearance="Secondary"
                           Click="GoHomeButton_OnClick"
                           ToolTip="{DynamicResource Explorer_Home}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Home24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Appearance="Secondary"
                           Click="GoBackButton_OnClick"
                           IsEnabled="{Binding CanGoBack}"
                           Margin="6,0,0,0"
                           ToolTip="{DynamicResource Explorer_Back}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowLeft24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Appearance="Secondary"
                           Click="GoForwardButton_OnClick"
                           IsEnabled="{Binding CanGoForward}"
                           Margin="6,0,0,0"
                           ToolTip="{DynamicResource Explorer_Forward}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRight24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Appearance="Secondary"
                           Click="GoUpButton_OnClick"
                           IsEnabled="{Binding CanGoUp}"
                           Margin="6,0,0,0"
                           ToolTip="{DynamicResource Explorer_Up}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowUp24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ui:Card Grid.Row="2"
                 Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox PlaceholderText="{DynamicResource Explorer_Search}"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,10,0">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ui:Button Content="{DynamicResource Explorer_NewFolder}"
                               Appearance="Primary"
                               Click="AddFolderButton_OnClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{DynamicResource Explorer_AddMedia}"
                               Appearance="Secondary"
                               Click="AddMediaButton_OnClick"
                               Margin="6,0,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="MusicNote224"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{DynamicResource Explorer_Rename}"
                               Appearance="Secondary"
                               Click="RenameButton_OnClick"
                               IsEnabled="{Binding HasSelectedEntry}"
                               Margin="6,0,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Edit24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{DynamicResource Explorer_Delete}"
                               Appearance="Secondary"
                               Click="DeleteButton_OnClick"
                               IsEnabled="{Binding HasSelectedEntry}"
                               Margin="6,0,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               Command="{Binding OpenInWindowsExplorerCommand}"
                               IsEnabled="{Binding HasSelectedEntry}"
                               Margin="6,0,0,0"
                               ToolTip="{DynamicResource Explorer_OpenWindows}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Open24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshCurrentFolderCommand}"
                               Margin="6,0,0,0"
                               ToolTip="{DynamicResource Explorer_Refresh}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,4,6,12">
                        <TextBlock Text="{DynamicResource Explorer_Folders}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FolderTree.Count}"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FolderTree}"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="FolderTree_OnSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Padding="9,8"
                                        CornerRadius="9"
                                        Margin="0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Folder24"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="9,0,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2"
                     Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="6,4,6,10">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Explorer_Content}"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Entries.Count}"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Explorer_DoubleClickHint}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SortMode}"
                                      Width="142"
                                      Height="34"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{Binding FilteredEntries}"
                                  SelectedItem="{Binding SelectedEntry}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <EventSetter Event="MouseDoubleClick"
                                                 Handler="Entry_OnDoubleClick"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            CornerRadius="11"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid MinHeight="72">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.Column="0"
                                                           Symbol="Folder24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Folder24"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                                <Setter Property="Symbol" Value="Document24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>

                                            <Border Grid.Column="1"
                                                    Width="48"
                                                    Height="48"
                                                    CornerRadius="10"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Document24"
                                                                   FontSize="22"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Image Source="{Binding ThumbnailUrl}"
                                                           Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        Margin="10,0,18,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MediaTitle}"
                                                           Margin="0,2,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsMedia, Converter={StaticResource BooleanToVisibilityConverterFallback}}"/>
                                                <TextBlock Text="{Binding MediaArtist}"
                                                           Margin="0,2,0,0"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsMedia, Converter={StaticResource BooleanToVisibilityConverterFallback}}"/>
                                                <TextBlock Text="{Binding FullPath}"
                                                           Margin="0,3,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}"/>
                                                <ProgressBar Height="5"
                                                             Margin="0,6,0,0"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercent}"
                                                             Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverterFallback}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding KindText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding SizeText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <StackPanel Grid.Column="5"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="7,0,0,0"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="7,4,0,0">
                                                    <TextBlock Text="{Binding SpeedText}"
                                                               FontSize="8"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="8"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding EtaText}"
                                                               FontSize="8"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="{DynamicResource LayerFillColorAltBrush}"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="430">
                                <ui:SymbolIcon Symbol="FolderOpen24"
                                               FontSize="54"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Explorer_EmptyTitle}"
                                           Margin="0,14,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Explorer_EmptySubtitle}"
                                           Margin="0,6,0,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Opacity="0.94"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True"
                                                 Width="34"
                                                 Height="34"/>
                                <TextBlock Text="{DynamicResource Explorer_Refresh}"
                                           Margin="0,10,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>