<UserControl x:Class="MediaForge.App.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <Grid Margin="30,24,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Grid Grid.Row="0">
            <Border Background="#F8FAFD"
                    BorderBrush="#DFE6EF"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="10,0"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="חזרה לבית  ⌂"
                                Click="GoHomeButton_OnClick"
                                MinWidth="126"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                        <Button Content="‹"
                                Click="GoBackButton_OnClick"
                                IsEnabled="{Binding CanGoBack}"
                                Width="42"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"
                                ToolTip="אחורה"/>
                        <Button Content="›"
                                Click="GoForwardButton_OnClick"
                                IsEnabled="{Binding CanGoForward}"
                                Width="42"
                                Margin="6,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"
                                ToolTip="קדימה"/>
                    </StackPanel>

                    <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center" Width="650">
                        <TextBlock Text="מיקום"
                                   DockPanel.Dock="Right"
                                   Margin="0,0,10,0"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#7C899A"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CurrentPath}"
                                 IsReadOnly="True"
                                 Style="{StaticResource MediaForgePathBoxStyle}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Margin="0,0,8,0"
                        Background="{StaticResource MediaForgePendingSoftBrush}"
                        BorderBrush="#E6D38D"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="9,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding DataContext.PendingCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0} שינויים ממתינים}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="#9B7800"/>
                </Border>
                <Button Content="＋  הוסף תיקייה"
                        Click="AddFolderButton_OnClick"
                        MinWidth="142"
                        Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                <Button Content="שנה שם"
                        Click="RenameButton_OnClick"
                        IsEnabled="{Binding HasSelectedEntry}"
                        MinWidth="104"
                        Margin="8,0,0,0"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                <Button Content="מחק"
                        Click="DeleteButton_OnClick"
                        IsEnabled="{Binding HasSelectedEntry}"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Style="{StaticResource MediaForgeDangerButtonStyle}"/>
                <Button Content="♫  הוסף מדיה"
                        Click="AddMediaButton_OnClick"
                        MinWidth="140"
                        Margin="8,0,0,0"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#56667D"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420"/>
                <TextBlock Text="הכול נשאר זמני עד לשמירת השינויים"
                           Margin="0,3,0,0"
                           FontSize="9.5"
                           Foreground="#9AA5B4"/>
            </StackPanel>
        </Grid>

        <!-- Explorer split -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F9FBFE"
                    BorderBrush="#DFE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Right"
                                Margin="4,0,4,0">
                        <TextBlock Text="תיקיות"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#26364D"/>
                        <TextBlock Text="עץ התיקיות של המקור"
                                   Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#8A96A7"/>
                    </StackPanel>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FolderTree}"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="FolderTree_OnSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Padding="9,8"
                                        CornerRadius="9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MediaForgePendingSoftBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0D0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="▣"
                                                   Margin="0,0,8,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource MediaForgeAccentBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="#3B4A60"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Grid.Column="2"
                                                 Width="7"
                                                 Height="7"
                                                 Margin="8,0,0,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Fill" Value="{StaticResource MediaForgePendingBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#DFE7F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="תוכן התיקייה"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#223149"/>
                            <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} פריטים}"
                                       Margin="0,3,0,0"
                                       FontSize="9.5"
                                       Foreground="#8B97A8"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#F3F6FA"
                                CornerRadius="9"
                                Padding="9,5">
                            <TextBlock Text="{Binding CurrentPath}"
                                       FontSize="9.5"
                                       Foreground="#7B899C"
                                       MaxWidth="620"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="שם" FontSize="9.5" FontWeight="Bold" Foreground="#8B97A8"/>
                        <TextBlock Grid.Column="1" Text="סוג" FontSize="9.5" FontWeight="Bold" Foreground="#8B97A8"/>
                        <TextBlock Grid.Column="2" Text="גודל" FontSize="9.5" FontWeight="Bold" Foreground="#8B97A8"/>
                        <TextBlock Grid.Column="3" Text="מצב" FontSize="9.5" FontWeight="Bold" Foreground="#8B97A8"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding Entries}"
                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="Entry_OnDoubleClick"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EDF4FF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F7FAFD"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E7ECF2"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="CornerRadius" Value="10"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                        <Setter Property="Background" Value="#FFFBF2"/>
                                                        <Setter Property="BorderBrush" Value="#E3C96F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                        <Setter Property="Background" Value="#FFF6E4"/>
                                                        <Setter Property="BorderBrush" Value="#DDB35B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Background" Value="#FFF2F4"/>
                                                        <Setter Property="BorderBrush" Value="#E0AEB7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid MinHeight="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="9"
                                                        Background="#EFF5FC">
                                                    <TextBlock Text="{Binding IsDirectory, Converter={StaticResource DirectoryGlyphConverter}}"
                                                               FontSize="15"
                                                               Foreground="{StaticResource MediaForgeAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Margin="11,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2C3A50"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                                                                        <Setter Property="Foreground" Value="#A17418"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="#C63E50"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding FullPath}"
                                                               Margin="0,3,0,0"
                                                               FontSize="8.5"
                                                               Foreground="#9AA5B4"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="540"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding KindText}"
                                                       FontSize="10"
                                                       Foreground="#7C899B"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeText}"
                                                       FontSize="10"
                                                       Foreground="#7C899B"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MediaForgeSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource MediaForgePendingBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource MediaForgeErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="7,0,0,0"
                                                           FontSize="10"
                                                           Foreground="#758297"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="#FBFCFE"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="64"
                                        Height="64"
                                        CornerRadius="20"
                                        Background="#EDF4FF">
                                    <TextBlock Text="♫"
                                               FontSize="26"
                                               Foreground="{StaticResource MediaForgeAccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="התיקייה ריקה"
                                           Margin="0,12,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#2A374C"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="הוסף תיקייה או מדיה כדי להתחיל"
                                           Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="#8794A6"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Pending changes -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Background="#FFFDF8"
                BorderBrush="#E7D9A7"
                BorderThickness="1"
                CornerRadius="14"
                Padding="13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="שינויים ממתינים"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#334157"/>
                            <Border Margin="8,0,0,0"
                                    Padding="7,2"
                                    Background="#FFF0C2"
                                    CornerRadius="8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.PendingOperations.Count, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#9B7600"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="שום דבר לא נכתב לדיסק עד שתלחץ על שמור שינויים"
                                   Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="#8D815F"/>
                    </StackPanel>

                    <Button Content="שמור שינויים"
                            Command="{Binding DataContext.SaveChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding DataContext.HasPendingChanges, RelativeSource={RelativeSource AncestorType=Window}}"
                            MinWidth="138"
                            MinHeight="40"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView ItemsSource="{Binding DataContext.PendingOperations, RelativeSource={RelativeSource AncestorType=Window}}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,1"
                                      MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#9B7B31"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Target}"
                                               FontSize="9.5"
                                               Foreground="#536177"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            Content="בטל"
                                            Command="{Binding DataContext.UndoPendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding OperationId}"
                                            MinWidth="54"
                                            MinHeight="28"
                                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Visibility="{Binding DataContext.HasPendingChanges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Background="#FFFFFF"
                            CornerRadius="10">
                        <TextBlock Text="אין כרגע שינויים ממתינים"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="#9BA6B5"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
