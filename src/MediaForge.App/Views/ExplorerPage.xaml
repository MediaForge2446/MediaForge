<UserControl x:Class="MediaForge.App.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ExplorerEntryBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E8EDF3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Background" Value="#FFFCF4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                    <Setter Property="Background" Value="#FFF8E8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#FFF3F4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Background" Value="#EDF5FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="188"/>
        </Grid.RowDefinitions>

        <!-- Top navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#F7FAFD" BorderBrush="#DFE7F0" BorderThickness="1"
                        CornerRadius="13" Padding="14,0" Height="44" MinWidth="430" MaxWidth="720">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="מיקום"
                                   DockPanel.Dock="Right"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#7B899D"/>
                        <TextBox Text="{Binding CurrentPath}"
                                 IsReadOnly="True"
                                 Style="{StaticResource MediaForgePathBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 />
                    </DockPanel>
                </Border>

                <Button Content="›"
                        Click="GoForwardButton_OnClick"
                        IsEnabled="{Binding CanGoForward}"
                        Width="44" Height="44" Margin="8,0,0,0"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"
                        ToolTip="קדימה"/>
                <Button Content="‹"
                        Click="GoBackButton_OnClick"
                        IsEnabled="{Binding CanGoBack}"
                        Width="44" Height="44" Margin="6,0,0,0"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"
                        ToolTip="אחורה"/>
                <Button Content="חזרה לבית  ⌂"
                        Click="GoHomeButton_OnClick"
                        MinWidth="132"
                        Margin="10,0,0,0"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#DDE6F0"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="＋  הוסף תיקייה"
                            Click="AddFolderButton_OnClick"
                            MinWidth="152" MinHeight="44"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                    <Button Content="שנה שם"
                            Click="RenameButton_OnClick"
                            IsEnabled="{Binding HasSelectedEntry}"
                            MinWidth="112" MinHeight="44" Margin="9,0,0,0"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    <Button Content="מחק"
                            Click="DeleteButton_OnClick"
                            IsEnabled="{Binding HasSelectedEntry}"
                            MinWidth="92" MinHeight="44" Margin="9,0,0,0"
                            Style="{StaticResource MediaForgeDangerButtonStyle}"/>
                    <Button Content="♫  הוסף מדיה"
                            Click="AddMediaButton_OnClick"
                            MinWidth="150" MinHeight="44" Margin="9,0,0,0"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#5C6D84"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360"/>
                    <TextBlock Text="השינויים לא נכתבים לדיסק לפני שמירה"
                               Margin="0,3,0,0"
                               FontSize="9.5"
                               Foreground="#99A5B5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- File explorer -->
        <Grid Grid.Row="2" Margin="0,16,0,0" MinHeight="350">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="282"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <Border Grid.Column="0"
                    Background="#F9FBFE"
                    BorderBrush="#DDE6F0"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,4,12">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="תיקיות"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#22324A"/>
                            <TextBlock Text="ניווט בתוך התיקייה הראשית"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#8794A6"/>
                        </StackPanel>
                    </Grid>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FolderTree}"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="FolderTree_OnSelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Padding="9,8"
                                        CornerRadius="10"
                                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▣"
                                                   FontSize="15"
                                                   Margin="0,0,9,0"
                                                   Foreground="{StaticResource MediaForgeAccentBrush}"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   Foreground="#3E4E65"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Main content -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#DDE6F0"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="3,0,3,8">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="תוכן התיקייה"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#22324A"/>
                            <TextBlock Text="{Binding CurrentPath}"
                                       Margin="0,4,0,0"
                                       FontSize="10"
                                       Foreground="#8A97A9"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="650"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#F3F7FB"
                                CornerRadius="10"
                                Padding="10,6">
                            <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} פריטים}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#728196"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="3,0,3,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="שם" FontSize="9.5" FontWeight="Bold" Foreground="#8996A8"/>
                        <TextBlock Grid.Column="1" Text="סוג" FontSize="9.5" FontWeight="Bold" Foreground="#8996A8"/>
                        <TextBlock Grid.Column="2" Text="גודל" FontSize="9.5" FontWeight="Bold" Foreground="#8996A8"/>
                        <TextBlock Grid.Column="3" Text="מצב" FontSize="9.5" FontWeight="Bold" Foreground="#8996A8"/>
                    </Grid>

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <EventSetter Event="MouseDoubleClick" Handler="Entry_OnDoubleClick"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F7FAFD"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EDF5FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ExplorerEntryBorderStyle}"
                                        Padding="11,9">

                                    <Grid MinHeight="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38"
                                                    CornerRadius="10"
                                                    Background="#EEF5FD">
                                                <TextBlock Text="{Binding IsDirectory, Converter={StaticResource DirectoryGlyphConverter}}"
                                                           FontSize="16"
                                                           Foreground="{StaticResource MediaForgeAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2C3C52"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                                                                    <Setter Property="Foreground" Value="#A57718"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C33F4E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FullPath}"
                                                           Margin="0,3,0,0"
                                                           FontSize="9"
                                                           Foreground="#9AA6B6"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="520"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding KindText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#7E8C9E"
                                                   FontSize="10.5"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#7E8C9E"
                                                   FontSize="10.5"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource MediaForgeSuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource MediaForgePendingBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource MediaForgeErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Margin="8,0,0,0"
                                                       FontSize="10.5"
                                                       Foreground="#748297"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2"
                            Panel.ZIndex="2"
                            Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Background="#FBFDFF"
                            BorderBrush="#E5ECF3"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="68" Height="68"
                                    CornerRadius="21"
                                    Background="#EAF3FF">
                                <TextBlock Text="♫"
                                           FontSize="27"
                                           Foreground="{StaticResource MediaForgeAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="אין כאן פריטים עדיין"
                                       Margin="0,13,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#2B394F"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="הוסף תיקייה או הוסף מדיה כדי להתחיל"
                                       Margin="0,5,0,0"
                                       FontSize="10.5"
                                       Foreground="#8794A7"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Pending changes -->
        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Background="#FFFCF4"
                BorderBrush="#E8D79D"
                BorderThickness="1"
                CornerRadius="18"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="שינויים ממתינים"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#34435A"/>
                            <Border Margin="9,0,0,0"
                                    Background="#FFF1CB"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.PendingOperations.Count, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#A87500"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="שינויים נשמרים בצד עד שתבחר לשמור אותם לדיסק"
                                   Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#8E805F"/>
                    </StackPanel>

                    <Button Content="שמור שינויים  ✓"
                            Command="{Binding DataContext.SaveChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding DataContext.HasPendingChanges, RelativeSource={RelativeSource AncestorType=Window}}"
                            MinWidth="158"
                            MinHeight="42"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#E9E1C9"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ListView ItemsSource="{Binding DataContext.PendingOperations, RelativeSource={RelativeSource AncestorType=Window}}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,2" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="#9B7F39"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Target}"
                                               FontSize="10"
                                               Foreground="#506076"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            Content="בטל"
                                            Command="{Binding DataContext.UndoPendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding OperationId}"
                                            MinWidth="58"
                                            MinHeight="30"
                                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>