<UserControl x:Class="MediaForge.App.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="162"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="סייר הספרייה"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#15263D"/>
                <TextBlock Text="{Binding CurrentPath}"
                           Margin="0,5,0,0"
                           FontSize="10.5"
                           Foreground="#7C899A"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CurrentPath}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Button Content="⌂  לבית"
                        Click="GoHomeButton_OnClick"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"
                        MinWidth="108"/>
                <Button Content="←"
                        Click="GoBackButton_OnClick"
                        IsEnabled="{Binding CanGoBack}"
                        Margin="8,0,0,0"
                        Width="42"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"
                        ToolTip="אחורה"/>
                <Button Content="→"
                        Click="GoForwardButton_OnClick"
                        IsEnabled="{Binding CanGoForward}"
                        Margin="6,0,0,0"
                        Width="42"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"
                        ToolTip="קדימה"/>
                <Button Content="↑"
                        Click="GoUpButton_OnClick"
                        IsEnabled="{Binding CanGoUp}"
                        Margin="6,0,0,0"
                        Width="42"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}"
                        ToolTip="תיקיית אב"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE6F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="＋  תיקייה"
                            Click="AddFolderButton_OnClick"
                            MinWidth="104"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                    <Button Content="✎  שנה שם"
                            Click="RenameButton_OnClick"
                            IsEnabled="{Binding HasSelectedEntry}"
                            Margin="7,0,0,0"
                            MinWidth="108"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    <Button Content="⌫  מחק"
                            Click="DeleteButton_OnClick"
                            IsEnabled="{Binding HasSelectedEntry}"
                            Margin="7,0,0,0"
                            MinWidth="88"
                            Style="{StaticResource MediaForgeDangerButtonStyle}"/>
                    <Button Content="♫  הוסף מדיה"
                            Click="AddMediaButton_OnClick"
                            Margin="7,0,0,0"
                            MinWidth="126"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Border Padding="0"
                            Background="#FFFFFF"
                            BorderBrush="#D8E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="230"
                            Height="40">
                        <DockPanel>
                            <TextBlock Text="⌕"
                                       DockPanel.Dock="Right"
                                       Margin="0,0,8,0"
                                       FontSize="17"
                                       Foreground="#8190A2"
                                       VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MediaForgePathBoxStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4,0"
                                     ToolTip="חיפוש בתיקייה"/>
                        </DockPanel>
                    </Border>

                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortMode}"
                              Width="120"
                              Height="40"
                              Margin="7,0,0,0"
                              Style="{StaticResource MediaForgeComboStyle}"/>

                    <Button Content="↻"
                            Command="{Binding RefreshCurrentFolderCommand}"
                            Width="42"
                            Height="40"
                            Margin="7,0,0,0"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"
                            ToolTip="רענן"/>
                    <Button Content="↗"
                            Command="{Binding OpenInWindowsExplorerCommand}"
                            IsEnabled="{Binding HasSelectedEntry}"
                            Width="42"
                            Height="40"
                            Margin="6,0,0,0"
                            Style="{StaticResource MediaForgeSubtleButtonStyle}"
                            ToolTip="פתח בסייר Windows"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="276"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Right"
                                Margin="4,2,4,0">
                        <TextBlock Text="תיקיות"
                                   Style="{StaticResource MediaForgeSectionTitleStyle}"/>
                        <TextBlock Text="מבנה הספרייה"
                                   Margin="0,4,0,0"
                                   FontSize="9.5"
                                   Foreground="#8B97A8"/>
                    </StackPanel>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FolderTree}"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="FolderTree_OnSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border Padding="9,8"
                                        CornerRadius="9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MediaForgePendingSoftBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                    <Setter Property="Background" Value="#FFF2D9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="▣"
                                                   Margin="0,0,9,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource MediaForgeAccentBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="11.5"
                                                   Foreground="#34435A"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Grid.Column="2"
                                                 Width="7"
                                                 Height="7"
                                                 Margin="8,0,0,0"
                                                 Fill="{StaticResource MediaForgePendingBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="תוכן"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1D2E47"/>
                            <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} פריטים}"
                                       Margin="0,3,0,0"
                                       FontSize="9.5"
                                       Foreground="#8A96A7"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="10,6"
                                Background="#F6F9FC"
                                CornerRadius="9">
                            <TextBlock Text="לחיצה כפולה פותחת תיקייה"
                                       FontSize="9.5"
                                       Foreground="#7A889B"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="שם"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="#8B97A8"/>
                        <TextBlock Grid.Column="1"
                                   Text="סוג"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="#8B97A8"/>
                        <TextBlock Grid.Column="2"
                                   Text="גודל"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="#8B97A8"/>
                        <TextBlock Grid.Column="3"
                                   Text="מצב"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="#8B97A8"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding FilteredEntries}"
                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="Entry_OnDoubleClick"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EDF4FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,9"
                                            CornerRadius="10"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E7EDF3"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FBFDFF"/>
                                                        <Setter Property="BorderBrush" Value="#D6E4F5"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                        <Setter Property="Background" Value="#FFFCF4"/>
                                                        <Setter Property="BorderBrush" Value="#E6D49A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                        <Setter Property="Background" Value="#FFF7E8"/>
                                                        <Setter Property="BorderBrush" Value="#E0BD70"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Background" Value="#FFF3F5"/>
                                                        <Setter Property="BorderBrush" Value="#E2B4BC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid MinHeight="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="115"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="34" Height="34"
                                                        CornerRadius="9"
                                                        Background="#F0F5FB">
                                                    <TextBlock Text="{Binding IsDirectory, Converter={StaticResource DirectoryGlyphConverter}}"
                                                               FontSize="14"
                                                               Foreground="{StaticResource MediaForgeAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.2"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2C3A50"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                                                                        <Setter Property="Foreground" Value="#9D7219"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="#C83E53"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding FullPath}"
                                                               Margin="0,3,0,0"
                                                               FontSize="8.5"
                                                               Foreground="#9BA6B4"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="540"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding KindText}"
                                                       FontSize="10"
                                                       Foreground="#7B889A"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeText}"
                                                       FontSize="10"
                                                       Foreground="#7B889A"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MediaForgeSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource MediaForgePendingBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource MediaForgeErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="7,0,0,0"
                                                           FontSize="9.5"
                                                           Foreground="#758297"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Background="#FBFCFE"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="66" Height="66"
                                        CornerRadius="20"
                                        Background="#EDF4FF">
                                    <TextBlock Text="＋"
                                               FontSize="27"
                                               Foreground="{StaticResource MediaForgeAccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="התיקייה ריקה"
                                           Margin="0,12,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#2B3A50"/>
                                <TextBlock Text="הוסף תיקייה או מדיה כדי להתחיל"
                                           Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="#8794A6"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                Background="#EFFFFFFF"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="230" Height="4"
                                             IsIndeterminate="True"/>
                                <TextBlock Text="מרענן את התיקייה…"
                                           Margin="0,10,0,0"
                                           FontSize="10"
                                           Foreground="#6F7E92"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="6"
                Padding="13"
                Background="#FFFDF8"
                BorderBrush="#E7D9A7"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="שינויים ממתינים"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2F3D52"/>
                            <Border Margin="8,0,0,0"
                                    Padding="7,2"
                                    Background="#FFF0C4"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding DataContext.PendingOperations.Count, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#9A7500"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="השינויים עדיין בטוחים. רק 'שמור שינויים' כותב אותם למחשב."
                                   Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="#8D815F"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Button Content="שמור שינויים"
                                Command="{Binding DataContext.SaveChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding DataContext.HasPendingChanges, RelativeSource={RelativeSource AncestorType=Window}}"
                                MinWidth="142"
                                Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
                        <Button Content="בטל הכול"
                                Command="{Binding DataContext.DiscardPendingChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding DataContext.HasPendingChanges, RelativeSource={RelativeSource AncestorType=Window}}"
                                MinWidth="92"
                                Margin="8,0,0,0"
                                Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView ItemsSource="{Binding DataContext.PendingOperations, RelativeSource={RelativeSource AncestorType=Window}}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,1"
                                      MinHeight="29">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OperationType}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#9B7B31"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Target}"
                                               FontSize="9.5"
                                               Foreground="#536177"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            Content="בטל"
                                            Command="{Binding DataContext.UndoPendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding OperationId}"
                                            MinWidth="54"
                                            MinHeight="28"
                                            Style="{StaticResource MediaForgeSubtleButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Visibility="{Binding DataContext.HasPendingChanges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Background="#FFFFFF"
                            CornerRadius="10">
                        <TextBlock Text="אין כרגע שינויים ממתינים"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="#9BA6B5"/>
                    </Border>

                    <StackPanel Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverterFallback}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="360">
                        <ProgressBar Value="{Binding DataContext.CommitProgressPercent, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Maximum="100"
                                     Height="5"/>
                        <TextBlock Text="{Binding DataContext.CommitProgressStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="0,8,0,0"
                                   FontSize="9.5"
                                   Foreground="#7A8798"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
