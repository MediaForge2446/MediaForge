<UserControl x:Class="MediaForge.App.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="סייר הקבצים" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="ניהול הספרייה בלי לגעת בדיסק עד ללחיצה על שמור שינויים" Margin="0,5,0,0" FontSize="13" Foreground="#87919E" />
            </StackPanel>
            <Button HorizontalAlignment="Left"
                    Content="↻  רענון"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MediaForgeSubtleButtonStyle}" />
        </Grid>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="↑"
                        Command="{Binding GoUpCommand}"
                        IsEnabled="{Binding CanGoUp}"
                        Width="42" Height="38"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}" />

                <Border Grid.Column="1" Margin="10,0" Padding="14,0"
                        Background="#0C1218" BorderBrush="#27333C" BorderThickness="1" CornerRadius="10">
                    <TextBox Text="{Binding CurrentPath}"
                             IsReadOnly="True"
                             Style="{StaticResource MediaForgePathBoxStyle}"
                             FontSize="12" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MediaForgeSuccessBrush}" />
                    <TextBlock Text=" פעיל" Margin="7,0,0,0" Foreground="#8C98A4" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBox Width="190"
                         Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MediaForgeInputStyle}"
                         ToolTip="שם התיקייה החדשה" />
                <Button Content="＋  תיקייה"
                        Command="{Binding CreateFolderCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource MediaForgeSubtleButtonStyle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="＋  הוסף מדיה לתיקייה"
                    Command="{Binding AddMediaCommand}"
                    Margin="10,0,0,0"
                    Style="{StaticResource MediaForgePrimaryButtonStyle}"
                    MinWidth="170" />

            <Button Grid.Column="2"
                    Content="שנה שם"
                    Command="{Binding RenameSelectedCommand}"
                    Margin="10,0,0,0"
                    Style="{StaticResource MediaForgeSubtleButtonStyle}" />

            <Button Grid.Column="3"
                    Content="מחיקה"
                    Command="{Binding DeleteSelectedCommand}"
                    Margin="10,0,0,0"
                    Style="{StaticResource MediaForgeDangerButtonStyle}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,11" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="שם" FontSize="10" FontWeight="Bold" Foreground="#697682" />
                    <TextBlock Grid.Column="1" Text="סוג" FontSize="10" FontWeight="Bold" Foreground="#697682" />
                    <TextBlock Grid.Column="2" Text="גודל" FontSize="10" FontWeight="Bold" Foreground="#697682" />
                    <TextBlock Grid.Column="3" Text="מצב" FontSize="10" FontWeight="Bold" Foreground="#697682" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,6,0,10" Style="{StaticResource MediaForgeCardStyle}">
                <ListView ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="8"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    CornerRadius="11"
                                    Background="#11171D"
                                    BorderBrush="#202A33"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#11171D" />
                                        <Setter Property="BorderBrush" Value="#202A33" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                <Setter Property="Background" Value="#151D23" />
                                                <Setter Property="BorderBrush" Value="#5C4A16" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                <Setter Property="Background" Value="#211C13" />
                                                <Setter Property="BorderBrush" Value="#9A7410" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Background" Value="#271619" />
                                                <Setter Property="BorderBrush" Value="#96363D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid MinHeight="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>

                                    <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" CornerRadius="9" Background="#17222B" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IsDirectory, Converter={StaticResource DirectoryGlyphConverter}}"
                                                           FontSize="17"
                                                           Foreground="{StaticResource MediaForgeAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DDE5EA" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MarkedForDeletion}" Value="True">
                                                                <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}" />
                                                                <Setter Property="Foreground" Value="#C1AC77" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF7C83" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" VerticalAlignment="Center" Foreground="#8E9BA6" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="#8E9BA6" FontSize="11" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MediaForgeSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Fill" Value="#FFC107" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Fill" Value="#F15B64" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="11" Foreground="#98A4AE" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Row="2" Padding="12" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="פעולות על הפריט שנבחר" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="שנה שם או העבר ממתינים עד לשמירה ואינם משנים את הדיסק." Margin="0,3,0,0" FontSize="10" Foreground="#6F7C88" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="180" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MediaForgeInputStyle}" ToolTip="שם חדש" />
                    <TextBox Grid.Column="2" Width="290" Margin="8,0,0,0" Text="{Binding MoveDestination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MediaForgeInputStyle}" ToolTip="נתיב יעד מלא להעברה" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
