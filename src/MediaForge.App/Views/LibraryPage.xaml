<UserControl x:Class="MediaForge.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">

    <Grid Margin="34,30,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,22">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="הבית"
                           FontSize="31"
                           FontWeight="Bold"
                           Foreground="#16243A"/>
                <TextBlock Text="התיקיות הראשיות שלך"
                           Margin="0,6,0,0"
                           FontSize="12.5"
                           Foreground="#7A889C"/>
            </StackPanel>

            <Button Content="＋  הוסף תיקייה ראשית"
                    Command="{Binding AddRootFolderCommand}"
                    MinWidth="190"
                    MinHeight="48"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RootFolders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenRootFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,0,18,18"
                                    HorizontalContentAlignment="Stretch">
                                <Border Width="410"
                                        MinHeight="190"
                                        Padding="22"
                                        Background="#FFFFFF"
                                        BorderBrush="#DCE5EF"
                                        BorderThickness="1"
                                        CornerRadius="20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#DCE5EF"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FBFDFF"/>
                                                    <Setter Property="BorderBrush" Value="#B9D5F5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="54"
                                                    Height="54"
                                                    CornerRadius="15"
                                                    Background="#EAF3FF">
                                                <TextBlock Text="▣"
                                                           FontSize="24"
                                                           Foreground="{StaticResource MediaForgeAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D2B40"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ScanStatus}"
                                                           Margin="0,5,0,0"
                                                           FontSize="10.5"
                                                           Foreground="#2EAF69"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Path}"
                                                   Margin="0,18,0,14"
                                                   FontSize="11"
                                                   Foreground="#718096"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"/>

                                        <Grid Grid.Row="2">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FolderCount}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#3C4A5E"/>
                                                <TextBlock Text=" תיקיות"
                                                           Margin="4,0,0,0"
                                                           FontSize="10.5"
                                                           Foreground="#7A879A"/>
                                                <TextBlock Text="  ·  "
                                                           Margin="9,0"
                                                           Foreground="#CBD4DE"/>
                                                <TextBlock Text="{Binding MediaCount}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#3C4A5E"/>
                                                <TextBlock Text=" מדיה"
                                                           Margin="4,0,0,0"
                                                           FontSize="10.5"
                                                           Foreground="#7A879A"/>
                                            </StackPanel>
                                            <TextBlock Text="פתח  ←"
                                                       HorizontalAlignment="Left"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MediaForgeAccentBrush}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Visibility="{Binding HasLibrary, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Background="#FAFCFF"
                    BorderBrush="#E2EAF3"
                    BorderThickness="1"
                    CornerRadius="20">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="88"
                            Height="88"
                            CornerRadius="28"
                            Background="#EAF3FF">
                        <TextBlock Text="+"
                                   FontSize="40"
                                   Foreground="{StaticResource MediaForgeAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="הוסף את התיקייה הראשית הראשונה"
                               Margin="0,19,0,0"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#172338"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="אחרי הבחירה תיכנס ישירות לסייר הקבצים."
                               Margin="0,7,0,20"
                               FontSize="11"
                               Foreground="#7A879A"
                               HorizontalAlignment="Center"/>
                    <Button Content="בחר תיקייה ראשית"
                            Command="{Binding AddRootFolderCommand}"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"
                            MinWidth="174"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>