<UserControl x:Class="MediaForge.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="הספרייה שלך" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="תיקיות המקור שלך הן מרכז העבודה של MediaForge."
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MediaForgeMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,20"
                Padding="16"
                Style="{StaticResource MediaForgeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#1A3440">
                    <TextBlock Text="✓" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource MediaForgeSuccessBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                    <TextBlock Text="מצב המערכת" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0"
                               Foreground="{StaticResource MediaForgeMutedBrush}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                    <TextBlock Text="שינויים ממתינים" FontSize="10" Foreground="{StaticResource MediaForgeMutedBrush}" />
                    <TextBlock Text="{Binding PendingCount}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RootFolders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="310" Height="178" Margin="0,0,16,16" Style="{StaticResource MediaForgeCardStyle}">
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14" Background="#202F3A">
                                        <TextBlock Text="▣" Foreground="{StaticResource MediaForgeAccentBrush}"
                                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayPath}" Margin="0,5,0,0"
                                                   FontSize="10" Foreground="{StaticResource MediaForgeMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DockPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource MediaForgeSuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text=" מחוברת" Margin="7,0,0,0" FontSize="10" Foreground="{StaticResource MediaForgeMutedBrush}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Left"
                                                Content="הסר"
                                                Command="{Binding DataContext.RemoveRootFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MediaForgeSubtleButtonStyle}" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Visibility="{Binding HasLibrary, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Margin="0,8"
                    Padding="48"
                    Style="{StaticResource MediaForgeCardStyle}"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="74" Height="74" CornerRadius="22" Background="#1E2E39">
                        <TextBlock Text="＋" FontSize="36" Foreground="{StaticResource MediaForgeAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="בוא נבנה את הספרייה שלך" Margin="0,18,0,0" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="בחר תיקייה אחת מהמחשב. אחר כך תוכל לנהל, להוסיף ולהוריד אליה מדיה."
                               Margin="0,7,0,20" FontSize="11" Foreground="{StaticResource MediaForgeMutedBrush}" HorizontalAlignment="Center" />
                    <Button Content="＋  הוספת תיקייה" Command="{Binding AddRootFolderCommand}"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
