<UserControl x:Class="MediaForge.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <Grid Margin="42,34,42,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="הבית"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172338"/>
                <TextBlock Text="בחר תיקייה ראשית כדי להיכנס לסביבת העבודה שלך"
                           Margin="0,6,0,0"
                           FontSize="12.5"
                           Foreground="#748198"/>
            </StackPanel>

            <Button Content="＋  הוסף תיקייה ראשית"
                    Command="{Binding AddRootFolderCommand}"
                    MinWidth="194"
                    MinHeight="46"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RootFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenRootFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,0,0,10">

                                <Border Background="#FFFFFF"
                                        BorderBrush="#DEE5EE"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="20">

                                    <Grid MinHeight="94">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="50"
                                                Height="50"
                                                CornerRadius="14"
                                                Background="#EDF4FF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="▣"
                                                       FontSize="21"
                                                       Foreground="{StaticResource MediaForgeAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,24,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#203049"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}"
                                                       Margin="0,5,0,0"
                                                       FontSize="10.5"
                                                       Foreground="#8491A3"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ScanSummary}"
                                                       FontSize="10.5"
                                                       Foreground="#68778B"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,6,0,0">
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Fill="{StaticResource MediaForgeSuccessBrush}"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ScanStatus}"
                                                           FontSize="10"
                                                           Foreground="#2E9E68"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="‹"
                                                   FontSize="24"
                                                   Foreground="#A6B1BF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#DEE5EE"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FBFDFF"/>
                                                    <Setter Property="BorderBrush" Value="#BFD7F5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Visibility="{Binding HasLibrary, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Background="#FFFFFF"
                    BorderBrush="#DEE5EE"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="82"
                            Height="82"
                            CornerRadius="25"
                            Background="#EDF4FF">
                        <TextBlock Text="＋"
                                   FontSize="36"
                                   Foreground="{StaticResource MediaForgeAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="עדיין אין תיקיות ראשיות"
                               Margin="0,18,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1C2A40"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="בחר תיקייה מהמחשב כדי להתחיל לעבוד."
                               Margin="0,7,0,18"
                               FontSize="11.5"
                               Foreground="#7B889B"
                               HorizontalAlignment="Center"/>
                    <Button Content="בחר תיקייה ראשית"
                            Command="{Binding AddRootFolderCommand}"
                            Style="{StaticResource MediaForgePrimaryButtonStyle}"
                            MinWidth="172"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
