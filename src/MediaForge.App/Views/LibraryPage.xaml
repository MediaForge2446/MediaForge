<UserControl x:Class="MediaForge.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="42,34,42,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Library_Title}"
                           FontSize="31"
                           FontWeight="Bold"
                           Foreground="#14253C"/>
                <TextBlock Text="{DynamicResource Library_Subtitle}"
                           Margin="0,7,0,0"
                           FontSize="12.5"
                           Foreground="#768499"/>
            </StackPanel>

            <Button Content="{DynamicResource Library_AddRoot}"
                    Command="{Binding AddRootFolderCommand}"
                    MinWidth="196"
                    Height="46"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MediaForgePrimaryButtonStyle}"/>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE6EF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="8">

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RootFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenRootFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,3">
                                    <Border Padding="18"
                                            CornerRadius="12">
                                        <Grid MinHeight="94">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="50"
                                                    Height="50"
                                                    CornerRadius="14"
                                                    Background="#EDF4FF"
                                                    VerticalAlignment="Center">
                                                <Image Width="38"
                                                       Height="38"
                                                       Source="{StaticResource MediaForgeIconImage}"
                                                       Stretch="Uniform"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,20,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#203049"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}"
                                                           Margin="0,5,0,0"
                                                           FontSize="10.5"
                                                           Foreground="#8591A3"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ScanSummary}"
                                                           FontSize="10.5"
                                                           Foreground="#627188"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ScanStatus}"
                                                           Margin="0,5,0,0"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MediaForgeSuccessBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="‹"
                                                       FontSize="23"
                                                       Foreground="#9BA8B8"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F6F9FC"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#EEF4F9"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Visibility="{Binding HasLibrary, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Background="#FBFCFE"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="430">
                        <Border Width="84"
                                Height="84"
                                CornerRadius="26"
                                Background="#0B1833">
                            <Image Width="66"
                                   Height="66"
                                   Source="{StaticResource MediaForgeIconImage}"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Library_EmptyTitle}"
                                   Margin="0,19,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#15253B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Library_Subtitle}"
                                   Margin="0,7,0,20"
                                   FontSize="11"
                                   Foreground="#7B889B"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Content="{DynamicResource Library_ChooseRoot}"
                                Command="{Binding AddRootFolderCommand}"
                                Style="{StaticResource MediaForgePrimaryButtonStyle}"
                                MinWidth="176"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>