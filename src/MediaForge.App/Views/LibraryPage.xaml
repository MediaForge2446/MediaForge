<UserControl x:Class="MediaForge.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="הבית" FontSize="30" FontWeight="Bold" Foreground="#172236"/>
                <TextBlock Text="כאן נמצאות רק התיקיות הראשיות שלך. פתח אחת כדי להיכנס לסביבת העבודה של MediaForge." Margin="0,5,0,0" FontSize="12" Foreground="#7C899B"/>
            </StackPanel>
            <Button Content="＋  תיקייה ראשית" Command="{Binding AddRootFolderCommand}" Style="{StaticResource MediaForgePrimaryButtonStyle}" HorizontalAlignment="Left" MinWidth="150"/>
        </Grid>

        <Grid Grid.Row="1">
            <ItemsControl ItemsSource="{Binding RootFolders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenRootFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,16,16} HorizontalContentAlignment="Stretch">
                            <Border Width="350" MinHeight="235" Padding="20" Style="{StaticResource MediaForgeCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="50" Height="50" CornerRadius="15" Background="#EAF3FF"><TextBlock Text="▣" FontSize="24" Foreground="{StaticResource MediaForgeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#243248" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ScanStatus}" Margin="0,4,0,0" FontSize="10" Foreground="#6D7D92"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Left" Padding="8,4" Background="#EEF8F3" BorderBrush="#D4EDDF" BorderThickness="1" CornerRadius="9">
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource MediaForgeSuccessBrush}" VerticalAlignment="Center"/><TextBlock Text=" מחובר" Margin="6,0,0,0" FontSize="9.5" Foreground="#2D7651"/></StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayPath}" Margin="0,17,0,0" FontSize="10.5" Foreground="#8692A4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                    <Grid Grid.Row="2" Margin="0,20,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="מדיה" FontSize="10" Foreground="#8491A3"/><TextBlock Text="{Binding MediaCount}" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#25344A"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="קבצים" FontSize="10" Foreground="#8491A3"/><TextBlock Text="{Binding FileCount}" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#25344A"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="גודל" FontSize="10" Foreground="#8491A3"/><TextBlock Text="{Binding TotalSizeText}" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#25344A"/></StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="פתח תיקייה  →" HorizontalAlignment="Left" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MediaForgeAccentBrush}"/>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Visibility="{Binding HasLibrary, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,4" Padding="50" Style="{StaticResource MediaForgeCardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="92" Height="92" CornerRadius="28" Background="#EAF3FF"><TextBlock Text="＋" FontSize="42" Foreground="{StaticResource MediaForgeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="הוסף את התיקייה הראשית הראשונה" Margin="0,20,0,0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#213047"/>
                    <TextBlock Text="אחרי שתבחר אותה, ייפתח סייר הקבצים של MediaForge עם כל התיקיות והמדיה שבתוכה." Margin="0,8,0,20" FontSize="11" Foreground="#7C899B" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Content="בחר תיקייה" Command="{Binding AddRootFolderCommand}" Style="{StaticResource MediaForgePrimaryButtonStyle}" HorizontalAlignment="Center" MinWidth="130"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>