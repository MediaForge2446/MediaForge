<UserControl x:Class="MediaForge.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="הגדרות" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="MediaForge מנהל את כלי המדיה ברקע, ללא צורך בהתקנה ידנית."
                       Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MediaForgeMutedBrush}" />

            <Border Margin="0,22,0,14" Padding="18" Style="{StaticResource MediaForgeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2">
                        <TextBlock Text="כלי המדיה" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="גרסאות מנוהלות ומאומתות לפני שימוש."
                                   Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MediaForgeMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,8">
                        <TextBlock Text="מצב:" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ToolStatus}" Margin="7,0,0,0" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="yt-dlp" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding YtDlpPath}" FontSize="10"
                               Foreground="{StaticResource MediaForgeMutedBrush}" Margin="20,0,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Text="FFmpeg" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FfmpegPath}" FontSize="10"
                               Foreground="{StaticResource MediaForgeMutedBrush}" Margin="20,8,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Button Content="אמת ותקן כלי מדיה" Command="{Binding VerifyToolsCommand}"
                    Style="{StaticResource MediaForgePrimaryButtonStyle}" HorizontalAlignment="Right" />

            <Border Margin="0,24,0,0" Padding="18" Style="{StaticResource MediaForgeCardStyle}">
                <StackPanel>
                    <TextBlock Text="עקרונות MediaForge" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="שינויים נשמרים תחילה בזיכרון ובאחסון מקומי, ורק Save Changes מבצע אותם במחשב."
                               Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource MediaForgeMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="הורדות מתבצעות ברקע עם ביטול, התקדמות וניקוי קבצים זמניים במקרה של כשל."
                               Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MediaForgeMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
