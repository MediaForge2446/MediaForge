<UserControl x:Class="MediaForge.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34">

            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource Settings_Title}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource App_Tagline}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Appearance}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Settings_Language}"
                                   Margin="0,18,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Settings_LanguageDescription}"
                                   Margin="0,5,0,8"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName"
                                  Height="42"
                                  AutomationProperties.Name="{DynamicResource Settings_Language}"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Tools}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Settings_ToolsDescription}"
                                   Margin="0,6,0,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ToolStatus}"
                                   Margin="0,18,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <ui:Button Content="{DynamicResource Settings_Tools}"
                                   Command="{Binding VerifyToolsCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanNotConverter}}"
                                   Appearance="Primary"
                                   Height="40"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding YtDlpPath}"
                                   Margin="0,14,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding YtDlpPath}"/>
                        <TextBlock Text="{Binding FfmpegPath}"
                                   Margin="0,5,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FfmpegPath}"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_DefaultFormat}"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Settings_DefaultFormatDescription}"
                               Margin="0,6,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <Grid>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{DynamicResource Settings_About}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource App_Title}"
                                   Margin="0,6,0,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Button Content="Terms of Service &amp; Disclaimer"
                            Click="OpenTerms_Click"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            MinWidth="220"
                            AutomationProperties.Name="Terms of Service and Disclaimer"/>
                </Grid>
            </ui:Card>

            <ui:Button Content="{DynamicResource Nav_Home}"
                       Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       HorizontalAlignment="Right"
                       Margin="0,16,0,0"
                       MinWidth="130"
                       Height="40"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
