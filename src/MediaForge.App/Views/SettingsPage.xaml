<UserControl x:Class="MediaForge.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="הגדרות וכלים" FontSize="28" FontWeight="Bold" Foreground="#172236"/>
                    <TextBlock Text="בדיקת כלי המדיה ומצב האמינות של סביבת העבודה." Margin="0,5,0,0" FontSize="12" Foreground="#7C899B"/>
                </StackPanel>
                <Border HorizontalAlignment="Left" Padding="11,7" Background="#EEF8F3" BorderBrush="#D4EDDF" BorderThickness="1" CornerRadius="11">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource MediaForgeSuccessBrush}"/><TextBlock Text=" מערכת מוכנה" Margin="7,0,0,0" FontSize="10" Foreground="#2D7651"/></StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20" Style="{StaticResource MediaForgeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="כלי מדיה" FontSize="17" FontWeight="SemiBold" Foreground="#26354B"/>
                        <TextBlock Text="MediaForge מנהל את הכלים הנדרשים להורדה ומוודא שהם זמינים." Margin="0,5,0,0" FontSize="11" Foreground="#7C899B" TextWrapping="Wrap"/>
                        <Border Margin="0,18,0,12" Padding="12" Background="#F3F7FC" BorderBrush="#E0E8F1" BorderThickness="1" CornerRadius="12">
                            <TextBlock Text="{Binding ToolStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#38506F" TextWrapping="Wrap"/>
                        </Border>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="yt-dlp" FontWeight="SemiBold" Foreground="#344359"/>
                            <TextBlock Grid.Column="1" Text="{Binding YtDlpPath}" FontSize="10" Foreground="#7D8A9D" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="FFmpeg" FontWeight="SemiBold" Foreground="#344359"/>
                            <TextBlock Grid.Column="1" Text="{Binding FfmpegPath}" FontSize="10" Foreground="#7D8A9D" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Button Content="אמת ותקן כלים" Command="{Binding VerifyToolsCommand}" Style="{StaticResource MediaForgePrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="135"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="20" Style="{StaticResource MediaForgeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="אמינות" FontSize="17" FontWeight="SemiBold" Foreground="#26354B"/>
                        <TextBlock Text="הפעולות נשארות בטיוטה עד אישור מפורש של המשתמש." Margin="0,5,0,0" FontSize="11" Foreground="#7C899B" TextWrapping="Wrap"/>
                        <Border Margin="0,18,0,8" Padding="12" Background="#EEF8F3" CornerRadius="11"><TextBlock Text="●  Staging בטוח" FontSize="11" FontWeight="SemiBold" Foreground="#2E7652"/></Border>
                        <Border Margin="0,0,0,8" Padding="12" Background="#EEF8F3" CornerRadius="11"><TextBlock Text="●  שמירה אטומית והתאוששות" FontSize="11" FontWeight="SemiBold" Foreground="#2E7652"/></Border>
                        <Border Padding="12" Background="#EEF8F3" CornerRadius="11"><TextBlock Text="●  הורדות ברקע" FontSize="11" FontWeight="SemiBold" Foreground="#2E7652"/></Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,16,0,0" Padding="18" Style="{StaticResource MediaForgeCardStyle}">
                <StackPanel>
                    <TextBlock Text="מדיניות פעולה" FontSize="16" FontWeight="SemiBold" Foreground="#26354B"/>
                    <TextBlock Text="יצירה, שינוי שם, העברה, מחיקה והורדות הופכים תחילה לשינויים ממתינים." Margin="0,7,0,0" FontSize="11" Foreground="#7C899B"/>
                    <TextBlock Text="רק 'שמור שינויים' כותב את השינוי בפועל לדיסק." Margin="0,4,0,0" FontSize="11" Foreground="#7C899B"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>