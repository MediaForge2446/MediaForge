<Window x:Class="MediaForge.App.Views.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terms of Service &amp; Disclaimer"
        Width="860"
        Height="760"
        MinWidth="720"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#EEF3F8"
        ShowInTaskbar="False">

    <Border Margin="12"
            Background="#FFFFFF"
            BorderBrush="#D9E2EC"
            BorderThickness="1"
            CornerRadius="22">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,4,0,18">
                <TextBlock Text="TERMS OF SERVICE &amp; DISCLAIMER"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#12233D"/>
                <TextBlock Text="Please review these terms before using MediaForge."
                           Margin="0,7,0,0"
                           FontSize="11.5"
                           Foreground="#778499"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#F7FAFD"
                    BorderBrush="#E0E7EF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="1. Personal and Non-Commercial Use Only"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C42"
                                   Margin="0,0,0,7"/>
                        <TextBlock Text="This software is designed and provided solely for personal, educational, and non-commercial backup purposes. You agree to use this software only to download content that you own, hold the rights to, or content that is explicitly licensed under creative commons or public domain."
                                   FontSize="12"
                                   Foreground="#3E4D61"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="2. Compliance with Third-Party Terms"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C42"
                                   Margin="0,0,0,7"/>
                        <TextBlock Text="This software is an independent tool and is not affiliated, associated, authorized, endorsed by, or in any way officially connected with YouTube, Google LLC, or any of their subsidiaries. You acknowledge that downloading copyrighted content without authorization from the copyright holder is a violation of YouTube’s Terms of Service and may breach copyright laws in your jurisdiction."
                                   FontSize="12"
                                   Foreground="#3E4D61"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="3. User Responsibility &amp; Indemnification"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C42"
                                   Margin="0,0,0,7"/>
                        <TextBlock Text="You are solely and entirely responsible for any content you download using this software. The developer of this software does not condone, encourage, or facilitate copyright infringement. By using this software, you agree to indemnify and hold harmless the developer from any legal claims, damages, liabilities, or expenses arising out of your misuse of the software."
                                   FontSize="12"
                                   Foreground="#3E4D61"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="4. As-Is Software &amp; Availability"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#1D2C42"
                                   Margin="0,0,0,7"/>
                        <TextBlock Text="This software is provided &quot;as-is&quot; without any warranties. Third-party platforms (such as YouTube) may change their systems at any time, which may cause this software to stop functioning. The developer is under no obligation to provide ongoing updates or fixes."
                                   FontSize="12"
                                   Foreground="#3E4D61"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,0,6"/>

                        <Border Margin="0,14,0,0"
                                Padding="14"
                                Background="#FFF8E8"
                                BorderBrush="#F0D99A"
                                BorderThickness="1"
                                CornerRadius="11">
                            <TextBlock Text="By continuing, you acknowledge the terms above and your responsibility to comply with applicable laws and third-party platform terms."
                                       FontSize="11.5"
                                       Foreground="#6B5200"
                                       TextWrapping="Wrap"
                                       LineHeight="19"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <CheckBox x:Name="AgreementCheckBox"
                          AutomationProperties.Name="I have read, understood, and I agree to these terms"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          Foreground="#26364D"
                          Content="I have read, understood, and I agree to these terms. I assume full responsibility for using this software in compliance with local laws."
                          IsThreeState="False"
                          Margin="0,0,0,13"/>

                <Button x:Name="ContinueButton"
                        Content="CONTINUE"
                        Click="ContinueButton_Click"
                        IsEnabled="{Binding IsChecked, ElementName=AgreementCheckBox}"
                        HorizontalAlignment="Right"
                        MinWidth="150"
                        Style="{StaticResource MediaForgePrimaryButtonStyle}"
                        AutomationProperties.Name="Continue"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
