<Application
    x:Class="MediaForge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:MediaForge.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ChangeStatusToBrushConverter x:Key="ChangeStatusToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
