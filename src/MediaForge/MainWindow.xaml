<Window x:Class="MediaForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MediaForge" MinWidth="1180" MinHeight="760">
  <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
  <Grid Background="Transparent">
    <NavigationView x:Name="Nav" PaneDisplayMode="LeftCompact" IsSettingsVisible="True" SelectionChanged="OnSelectionChanged">
      <NavigationView.Header><Grid Margin="10,12,24,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradientBrush}"><FontIcon Glyph="&#xE7C5;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MediaForge" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Real files · Safe staging · Fast downloads" Style="{StaticResource SubtitleTextStyle}"/></StackPanel><Border Grid.Column="2" Padding="12,7" CornerRadius="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="{Binding PendingSummary}" FontWeight="SemiBold"/></Border></Grid></NavigationView.Header>
      <NavigationView.MenuItems><NavigationViewItem Content="Library" Tag="Library"><NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="Explorer" Tag="Explorer"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
      <NavigationView.PaneFooter><StackPanel Padding="10" Spacing="8"><InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Action failed" Message="{Binding LastError}" IsClosable="False"/><Button Content="Clear error" Click="ClearError" IsEnabled="{Binding HasError}"/></StackPanel></NavigationView.PaneFooter>
      <Frame x:Name="ContentFrame"><Frame.ContentTransitions><TransitionCollection><NavigationThemeTransition/></TransitionCollection></Frame.ContentTransitions></Frame>
    </NavigationView>
  </Grid>
</Window>
