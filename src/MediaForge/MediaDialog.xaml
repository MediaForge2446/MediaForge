<ContentDialog x:Class="MediaForge.MediaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Media" PrimaryButtonText="Add Changes" SecondaryButtonText="Cancel" PrimaryButtonClick="CommitDialog" DefaultButton="Primary">
  <Grid MinWidth="820" MaxWidth="1080" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4"><TextBlock Text="Add media" Style="{StaticResource TitleTextStyle}"/><TextBlock Text="Resolve a video or playlist, review every item, then stage the selection." Style="{StaticResource SubtitleTextStyle}"/></StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UrlBox" Header="YouTube URL" PlaceholderText="https://youtube.com/watch?..." TextChanged="UrlChanged"/><Button Grid.Column="1" Content="Resolve" Style="{StaticResource PrimaryButtonStyle}" Click="Resolve"/></Grid>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="Summary" FontWeight="SemiBold"/><TextBlock x:Name="Destination" Style="{StaticResource SubtitleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><ProgressRing Grid.Column="1" x:Name="Busy" Width="28" Height="28" IsActive="False"/></Grid></Border>
    <Grid Grid.Row="3" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Select all" Click="SelectAll"/><Button Content="Clear" Click="ClearAll"/><Button Content="All MP3" Click="AllMp3"/><Button Content="All MP4" Click="AllMp4"/></StackPanel><ListView Grid.Row="1" ItemsSource="{Binding Media}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,2"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Border Width="92" Height="92" CornerRadius="12" Background="{StaticResource SurfaceBrush}"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center"><CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}" Content="Download this item"/><TextBox Text="{Binding Title,Mode=TwoWay}"/><TextBlock Text="{Binding Artist}" Style="{StaticResource SubtitleTextStyle}"/><TextBlock Text="{Binding DurationText}" Style="{StaticResource SubtitleTextStyle}"/></StackPanel><ComboBox Grid.Column="2" SelectedIndex="{Binding FormatIndex,Mode=TwoWay}" VerticalAlignment="Center"><ComboBoxItem Content="MP3"/><ComboBoxItem Content="MP4"/></ComboBox></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid>
  </Grid>
</ContentDialog>
