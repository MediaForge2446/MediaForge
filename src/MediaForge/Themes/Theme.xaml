<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SurfaceBrush" Color="#B80E1420" />
  <SolidColorBrush x:Key="PanelBrush" Color="#CC151B26" />
  <SolidColorBrush x:Key="StrokeBrush" Color="#35FFFFFF" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#B8FFFFFF" />
  <SolidColorBrush x:Key="StatusGreenBrush" Color="#54D38A" />
  <SolidColorBrush x:Key="StatusYellowBrush" Color="#F2C45C" />
  <SolidColorBrush x:Key="StatusRedBrush" Color="#FF6B74" />
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7C4DFF" Offset="0"/><GradientStop Color="#2F8FFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SaveGradientBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#20B26B" Offset="0"/><GradientStop Color="#3CCB84" Offset="1"/></LinearGradientBrush>
  <ThemeShadow x:Key="CardShadow" />
  <Style x:Key="TitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="31"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SubtitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></Style>
  <Style x:Key="BaseButtonStyle" TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,8"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="Background" Value="{StaticResource SaveGradientBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinWidth" Value="136"/></Style>
  <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Shadow" Value="{StaticResource CardShadow}"/></Style>
</ResourceDictionary>
