<Page
    x:Class="MediaForge.Views.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaForge.Converters">
    <Page.Resources>
        <converters:ChangeStatusToBrushConverter x:Key="ChangeStatusBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:FailedStatusToVisibilityConverter x:Key="FailedStatusToVisibilityConverter" />
        <converters:PendingStatusEnabledConverter x:Key="PendingStatusEnabledConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="RootFolderPicker"
                      ItemsSource="{Binding ViewModel.RootFolders}"
                      DisplayMemberPath="DisplayName"
                      PlaceholderText="Select a library folder"
                      SelectionChanged="OnRootFolderChanged" />
            <Button Grid.Column="1" Content="New folder" Click="OnNewFolderClick" />
            <Button Grid.Column="2" Content="Rename" Click="OnRenameClick" />
            <Button Grid.Column="3" Content="Move" Click="OnMoveClick" />
            <Button Grid.Column="4" Content="Delete" Click="OnDeleteClick" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="←" Click="OnBackClick" />
            <Button Grid.Column="1" Content="↻" Click="OnRefreshClick" />
            <TextBox Grid.Column="2"
                     Text="{Binding ViewModel.CurrentPath, Mode=OneWay}"
                     IsReadOnly="True" />
        </Grid>

        <ListView Grid.Row="2"
                  x:Name="ExplorerList"
                  ItemsSource="{Binding ViewModel.Items}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="14" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8B7;" FontSize="20" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Kind}"
                                   Opacity="0.65"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SizeBytes}"
                                   Opacity="0.65"
                                   VerticalAlignment="Center" />
                        <Ellipse Grid.Column="4"
                                 Width="10"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource ChangeStatusBrushConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="3"
                Padding="16"
                CornerRadius="12"
                BorderThickness="1">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pending changes" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Changes are applied to disk only when you save."
                                   Opacity="0.65" />
                        <ProgressBar Margin="0,8,0,0"
                                     Maximum="1"
                                     Value="{Binding PendingViewModel.OverallProgress}"
                                     Visibility="{Binding PendingViewModel.IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Save changes"
                            Click="OnSaveChangesClick"
                            IsEnabled="{Binding PendingViewModel.CanSave}" />
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding PendingViewModel.Changes}"
                          MaxHeight="260"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="10" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="9"
                                         Height="9"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource ChangeStatusBrushConverter}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Type}"
                                           FontWeight="SemiBold" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TargetPath}"
                                               Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{Binding Status, Converter={StaticResource ChangeStatusBrushConverter}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Maximum="1"
                                                 Value="{Binding Progress}"
                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource FailedStatusBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Status, Converter={StaticResource FailedStatusToVisibilityConverter}}" />
                                </StackPanel>
                                <Button Grid.Column="3"
                                        Content="Undo"
                                        Tag="{Binding Id}"
                                        Click="OnUndoChangeClick"
                                        IsEnabled="{Binding Status, Converter={StaticResource PendingStatusEnabledConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18">
                    <TextBlock Text="● Synced" Foreground="{StaticResource SyncedStatusBrush}" />
                    <TextBlock Text="● Pending" Foreground="{StaticResource PendingStatusBrush}" />
                    <TextBlock Text="● Failed" Foreground="{StaticResource FailedStatusBrush}" />
                    <Button Content="Undo last" Click="OnUndoLastClick" IsEnabled="{Binding PendingViewModel.CanCancel}" />
                    <Button Content="Cancel all" Click="OnCancelAllClick" IsEnabled="{Binding PendingViewModel.CanCancel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
