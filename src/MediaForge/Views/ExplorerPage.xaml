<Page x:Class="MediaForge.ExplorerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="28" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Explorer" Style="{StaticResource TitleTextStyle}"/><TextBlock Text="Real Windows files. Every change is staged before it touches the disk." Style="{StaticResource SubtitleTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="New folder" Click="NewFolder"/><Button Content="Rename" Click="Rename"/><Button Content="Move" Click="Move"/><Button Content="Delete" Click="Delete"/></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="FolderPicker" ItemsSource="{Binding Folders}" DisplayMemberPath="Name" SelectionChanged="FolderChanged" PlaceholderText="Choose a root folder"/><Button Grid.Column="1" Content="←" Click="Back"/><Button Grid.Column="2" Content="↻" Click="Refresh"/></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding CurrentFolderName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentPath}" Style="{StaticResource SubtitleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><ListView Grid.Row="1" x:Name="FileList" ItemsSource="{Binding Files}" IsItemClickEnabled="True" ItemClick="OpenItem"><ListView.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,3"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ModifiedText}" Style="{StaticResource SubtitleTextStyle}"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Kind}" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Right"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtitleTextStyle}"/><Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource ChangeStatusToBrushConverter}}"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
    <Border Grid.Row="3" Style="{StaticResource CardStyle}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="Pending changes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nothing changes on disk until Save Changes." Style="{StaticResource SubtitleTextStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Undo last" Click="UndoLast"/><Button Content="Cancel all" Click="CancelAll"/><Button Content="Save Changes" Style="{StaticResource SaveButtonStyle}" Click="Save"/></StackPanel></Grid><ProgressBar Grid.Row="1" Maximum="1" Value="{Binding PendingProgress}"/><ListView Grid.Row="2" ItemsSource="{Binding Pending}" MaxHeight="190" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource ChangeStatusToBrushConverter}}"/><TextBlock Grid.Column="1" Text="{Binding Kind}" FontWeight="SemiBold"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding Error}" Style="{StaticResource SubtitleTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="3" Content="Undo" Tag="{Binding Id}" Click="UndoItem"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
  </Grid>
</Page>
