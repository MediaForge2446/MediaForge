<Page
    x:Class="MediaForge.Views.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="18" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Explorer" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Browse your real Windows folders and stage changes safely before committing them."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="New folder" Click="OnNewFolderClick" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Rename" Click="OnRenameClick" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Move" Click="OnMoveClick" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Delete" Click="OnDeleteClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RootFolderPicker"
                      ItemsSource="{Binding ViewModel.RootFolders}"
                      DisplayMemberPath="DisplayName"
                      PlaceholderText="Choose a library folder"
                      SelectionChanged="OnRootFolderChanged" />
            <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" Content="←" Click="OnBackClick" ToolTipService.ToolTip="Back" />
            <Button Grid.Column="2" Style="{StaticResource SubtleIconButtonStyle}" Content="↻" Click="OnRefreshClick" ToolTipService.ToolTip="Refresh" />
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ViewModel.CurrentFolderName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewModel.CurrentPath}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListView x:Name="ExplorerList"
                              ItemsSource="{Binding ViewModel.Items}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnItemClick">
                        <ListView.Resources>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastModifiedUtc, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplaySize}" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StatusLabel}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="4"
                                             Width="9"
                                             Height="9"
                                             Fill="{StaticResource SyncedStatusBrush}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel IsHitTestVisible="False"
                                Visibility="{Binding ViewModel.Items.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="36" HorizontalAlignment="Center" Opacity="0.45" />
                        <TextBlock Text="No items to show" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Choose a library folder to browse its real contents."
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="18"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Pending changes" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Review everything before it touches your files."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Undo last" Click="OnUndoLastClick" IsEnabled="{Binding PendingViewModel.CanUndo}" />
                        <Button Content="Cancel all" Click="OnCancelAllClick" IsEnabled="{Binding PendingViewModel.CanCancel}" />
                        <Button Content="Save Changes" Style="{StaticResource PrimaryToolbarButtonStyle}" Click="OnSaveChangesClick" IsEnabled="{Binding PendingViewModel.CanSave}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Maximum="1" Value="{Binding PendingViewModel.OverallProgress}" />

                <ListView Grid.Row="2" ItemsSource="{Binding PendingViewModel.Changes}" MaxHeight="250" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="10" RowSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" FontSize="16" VerticalAlignment="Center" Opacity="0.65" />
                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TargetPath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Maximum="1" Value="{Binding Progress}" />
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource FailedStatusBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Undo" Tag="{Binding Id}" Click="OnUndoChangeClick" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
