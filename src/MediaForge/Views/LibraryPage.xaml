<Page
    x:Class="MediaForge.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Library" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Manage your media folders and staged changes from one place."
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,16"
                    Orientation="Horizontal"
                    Spacing="12">
            <Button Content="Add root folder" Click="OnAddFolderClick" />
            <Button Content="Add media" Click="OnAddMediaClick" />
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{Binding ViewModel.RootFolders}"
                  SelectedItem="{Binding ViewModel.SelectedRootFolder, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="20"
                                  Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" />
                            <TextBlock Text="{Binding Path}"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Ellipse Grid.Column="2"
                                 Width="10"
                                 Height="10"
                                 Fill="{StaticResource SyncedStatusBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
