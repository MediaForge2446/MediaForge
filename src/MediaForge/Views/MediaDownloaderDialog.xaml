<ContentDialog
    x:Class="MediaForge.Views.MediaDownloaderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add media"
    PrimaryButtonText="Add to changes"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="780" MaxWidth="1080" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock Text="Add media" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Paste a media or playlist URL, review every item, then stage the selection."
                       Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox"
                     Header="Media URL"
                     PlaceholderText="https://..."
                     TextChanged="OnUrlTextChanged"
                     KeyDown="OnUrlKeyDown" />
            <Button Grid.Column="1"
                    Content="Detect"
                    Click="OnDetectClick"
                    IsEnabled="{Binding ViewModel.CanResolve}" />
        </Grid>

        <Border Grid.Row="2"
                Padding="14"
                CornerRadius="12"
                Background="{StaticResource AccentSurfaceBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="MediaTypeText" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedSummaryText" Opacity="0.72" />
                    <TextBlock Text="Destination" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ViewModel.TargetFolderPath}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressRing Grid.Column="1"
                              x:Name="ResolveProgressRing"
                              Width="28"
                              Height="28"
                              IsActive="False"
                              VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="PlaylistActionsPanel"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                <Button Content="Select all" Click="OnSelectAllClick" />
                <Button Content="Clear selection" Click="OnDeselectAllClick" />
                <Button Content="MP3 for all" Click="OnMp3AllClick" />
                <Button Content="MP4 for all" Click="OnMp4AllClick" />
            </StackPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding ViewModel.Items}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Margin="0,0,0,8"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <Border Width="84"
                                        Height="84"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentSurfaceBrush}">
                                    <Image Source="{Binding ThumbnailUrl}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="OnItemSelectionChanged"
                                              Unchecked="OnItemSelectionChanged"
                                              Content="Download this item" />
                                    <TextBox Text="{Binding Title, Mode=TwoWay}"
                                             PlaceholderText="Media title"
                                             LostFocus="OnTitleLostFocus" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Artist}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Duration}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          Header="Format"
                                          SelectedIndex="0"
                                          SelectionChanged="OnFormatChanged"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="MP3" Tag="Mp3" />
                                    <ComboBoxItem Content="MP4" Tag="Mp4" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="3">
                <TextBlock Text="Staging is safe" FontWeight="SemiBold" />
                <TextBlock Text="No files are downloaded or created until Save Changes is pressed in Explorer."
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
