<ContentDialog
    x:Class="MediaForge.Views.MediaDownloaderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add media"
    PrimaryButtonText="Add to changes"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    DefaultButton="Primary">
    <Grid MinWidth="720" MaxWidth="920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox"
                     Header="Media URL"
                     PlaceholderText="Paste a song or playlist URL"
                     TextChanged="OnUrlTextChanged"
                     KeyDown="OnUrlKeyDown" />
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Detect"
                    Click="OnDetectClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="MediaTypeText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SelectedSummaryText" Opacity="0.68" />
            </StackPanel>
            <ProgressRing x:Name="ResolveProgressRing"
                          Grid.Column="1"
                          Width="24"
                          Height="24"
                          IsActive="False" />
        </Grid>

        <StackPanel x:Name="PlaylistActionsPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
            <Button Content="Select all" Click="OnSelectAllClick" />
            <Button Content="Deselect all" Click="OnDeselectAllClick" />
            <Button Content="MP3 for all" Click="OnMp3AllClick" />
            <Button Content="MP4 for all" Click="OnMp4AllClick" />
        </StackPanel>

        <ListView Grid.Row="3"
                  Margin="0,14,0,14"
                  ItemsSource="{Binding ViewModel.Items}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            Margin="0,0,0,8"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Image Source="{Binding ThumbnailUrl}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="OnItemSelectionChanged"
                                          Unchecked="OnItemSelectionChanged"
                                          Content="Download" />
                                <TextBox Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="Song title"
                                         LostFocus="OnTitleLostFocus" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Artist}"
                                               Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Duration}"
                                               Opacity="0.55" />
                                </Grid>
                            </StackPanel>

                            <ComboBox Grid.Column="2"
                                      Header="Format"
                                      SelectionChanged="OnFormatChanged">
                                <ComboBoxItem Content="MP3" Tag="Mp3" IsSelected="True" />
                                <ComboBoxItem Content="MP4" Tag="Mp4" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="Changes are staged only. Nothing is downloaded until Save Changes."
                       VerticalAlignment="Center"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</ContentDialog>
