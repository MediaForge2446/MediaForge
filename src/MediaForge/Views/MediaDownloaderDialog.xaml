<ContentDialog
    x:Class="MediaForge.Views.MediaDownloaderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add media"
    PrimaryButtonText="Add to changes"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    DefaultButton="Primary">
    <Grid MinWidth="720" MaxWidth="920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox"
                     Header="Media URL"
                     PlaceholderText="Paste a song or playlist URL"
                     TextChanged="OnUrlTextChanged"
                     KeyDown="OnUrlKeyDown" />
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Detect"
                    Click="OnDetectClick"
                    IsEnabled="{Binding ViewModel.CanResolve}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding ViewModel.MediaTypeLabel}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ViewModel.SelectedSummary}"
                           Opacity="0.68" />
            </StackPanel>
            <ProgressRing Grid.Column="1"
                          Width="24"
                          Height="24"
                          IsActive="{Binding ViewModel.IsResolving}"
                          Visibility="{Binding ViewModel.IsResolving, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{Binding ViewModel.IsPlaylist, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Select all" Click="OnSelectAllClick" />
            <Button Content="Deselect all" Click="OnDeselectAllClick" />
            <Button Content="MP3 for all" Click="OnMp3AllClick" />
            <Button Content="MP4 for all" Click="OnMp4AllClick" />
        </StackPanel>

        <ListView Grid.Row="3"
                  Margin="0,14,0,14"
                  ItemsSource="{Binding ViewModel.Items}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10"
                            Margin="0,0,0,8"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <TextBlock Text="COVER"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Opacity="0.56" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="OnItemSelectionChanged"
                                          Unchecked="OnItemSelectionChanged"
                                          Content="Download" />
                                <TextBox Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="Song title"
                                         LostFocus="OnTitleLostFocus" />
                                <TextBlock Text="{Binding Artist}"
                                           Opacity="0.65"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ComboBox Grid.Column="2"
                                      Header="Format"
                                      SelectedValue="{Binding Format, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="OnFormatChanged">
                                <ComboBoxItem Content="MP3" Tag="Mp3" />
                                <ComboBoxItem Content="MP4" Tag="Mp4" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Changes are staged only. Nothing is downloaded until Save Changes."
                           VerticalAlignment="Center"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Margin="16,0,0,0"
                           Text="{Binding ViewModel.SelectedSummary}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
