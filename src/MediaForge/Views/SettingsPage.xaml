<Page
    x:Class="MediaForge.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaForge.Converters">
    <Page.Resources>
        <converters:ToolStatusToBrushConverter x:Key="ToolStatusBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20" MaxWidth="980">
            <StackPanel Spacing="5">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Keep downloads reliable with automatic media-tool maintenance."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid ColumnSpacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Background maintenance" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="MediaForge can check and update yt-dlp and FFmpeg without blocking the interface."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  Header="Automatic tool updates"
                                  OffContent="Off"
                                  OnContent="On"
                                  IsOn="{Binding ViewModel.AutomaticToolUpdates, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Media tools" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="These tools are stored per-user and updated safely with checksum verification."
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Check for updates"
                                    Click="OnCheckUpdatesClick"
                                    IsEnabled="{Binding ViewModel.CanUpdate}" />
                            <Button Content="Update all"
                                    Click="OnUpdateAllClick"
                                    IsEnabled="{Binding ViewModel.CanUpdate}"
                                    Style="{StaticResource PrimaryToolbarButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Maximum="1"
                                 Value="{Binding ViewModel.Progress}"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ItemsRepeater ItemsSource="{Binding ViewModel.Tools}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Converter={StaticResource ToolStatusBrushConverter}}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Foreground="{StaticResource FailedStatusBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Ready for downloads"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock Text="{Binding InstalledVersion}" HorizontalAlignment="Right" />
                                            <TextBlock Text="Latest: {Binding LatestVersion}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="Changes apply safely"
                     Message="Library edits and downloads stay staged until Save Changes is pressed in Explorer."
                     IsClosable="False" />

            <TextBlock Text="{Binding ViewModel.StatusMessage}"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
