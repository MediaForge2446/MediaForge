<Page
    x:Class="MediaForge.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaForge.Converters">
    <Page.Resources>
        <converters:ToolStatusToBrushConverter x:Key="ToolStatusBrushConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="24" MaxWidth="900">
            <StackPanel Spacing="6">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Keep MediaForge ready without managing download tools yourself."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Padding="20"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Automatic tool updates"
                                  OffContent="Off"
                                  OnContent="On"
                                  IsOn="{Binding ViewModel.AutomaticToolUpdates, Mode=TwoWay}" />
                    <TextBlock Text="MediaForge can check for and install current yt-dlp and FFmpeg builds in the background."
                               TextWrapping="Wrap"
                               Opacity="0.68" />
                </StackPanel>
            </Border>

            <Border Padding="20"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Media tools" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Required for physical downloads and conversion."
                                       Opacity="0.68" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="8,0"
                                Content="Check for updates"
                                Click="OnCheckUpdatesClick"
                                IsEnabled="{Binding ViewModel.CanUpdate}" />
                        <Button Grid.Column="2"
                                Content="Update all"
                                Click="OnUpdateAllClick"
                                IsEnabled="{Binding ViewModel.CanUpdate}" />
                    </Grid>

                    <ProgressBar Maximum="1"
                                 Value="{Binding ViewModel.Progress}"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ListView ItemsSource="{Binding ViewModel.Tools}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Converter={StaticResource ToolStatusBrushConverter}}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="{StaticResource FailedStatusBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{Binding InstalledVersion}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LatestVersion, TargetNullValue=Unknown}"
                                                   Opacity="0.6"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ViewModel.StatusMessage}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
